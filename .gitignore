# Dependencies
node_modules/

# Build output / generated
dist/
.astro/
.turbo/
**/build/

# Environment variables (never commit secrets)
.env
.env.*
!.env.template
!.env.example

# Local credential notes — never committed. Git history is permanent, so a
# password committed once stays retrievable even after it is deleted.
*.local.md

# Editor / local tooling
.claude/settings.local.json
# Claude Code worktrees live inside the repo. Git sees each one as a gitlink
# (mode 160000) and will happily stage it as a broken submodule ref.
.claude/worktrees/
.vscode/
.idea/
.playwright-mcp/

# Logs
*-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
