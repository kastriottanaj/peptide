---
import Seo from "../components/Seo.astro";
import WebMCPTools from "../components/WebMCPTools.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import { ANALYTICS_ENABLED } from "../lib/analytics";
import { BUILD_YEAR } from "../lib/build-time";

export interface Props {
	title: string;
	description?: string;
	/** When true, the page renders full-bleed sections (homepage). Otherwise content sits in a centered container. */
	wide?: boolean;
	/** Omit the brand suffix from <title> (the homepage carries it already). */
	rawTitle?: boolean;
	ogType?: "website" | "article" | "product";
	image?: { url: string; alt: string; width?: number; height?: number };
	noindex?: boolean;
	/** Extra JSON-LD nodes merged into the page @graph. */
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description = "Peptide Einkaufen – Forschungspeptide für wissenschaftliche und laborinterne Zwecke.",
	wide = false,
	rawTitle = false,
	ogType = "website",
	image,
	noindex = false,
	jsonLd = [],
} = Astro.props;
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<Seo
			title={title}
			description={description}
			rawTitle={rawTitle}
			ogType={ogType}
			image={image}
			noindex={noindex}
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<!-- Announcement bar -->
		<div class="announce">
			<div class="announce__inner">
				<span>Analytisch geprüfte Forschungspeptide · Diskreter Versand</span>
				<a href="/contact">Support anfragen</a>
			</div>
		</div>

		<!-- Header -->
		<header class="header">
			<div class="header__inner">
				<a href="/" class="brand">
					<span class="brand__mark">◆</span>
					<span>Peptide<span class="brand__accent">Einkaufen</span></span>
				</a>

				{/* The WebMCP tool attributes annotate this real form rather than a
				    hidden copy: a duplicate would give agents a second, invisible
				    search that can silently diverge from the one customers use. */}
				<form
					class="search"
					action="/produkte"
					method="get"
					role="search"
					toolname="search_site_form"
					tooldescription="Submit the site search form to load the product listing filtered by a keyword."
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
						<path d="m20 20-3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
					<label class="visually-hidden" for="site-search">Peptide suchen</label>
					<input
						id="site-search"
						type="search"
						name="q"
						placeholder="Peptide suchen…"
						autocomplete="off"
						toolparamdescription="The keyword or phrase to search for. Plain text, for example a product name or a research code such as BPC-157."
					/>
				</form>

				<nav class="nav">
					<a href="/produkte">Shop</a>
					<a href="/wissen">Wissen</a>
					<a href="/wissen/reinheit-und-coa">Zertifikate</a>
					<a href="/contact">Support</a>
					<a href="/warenkorb" class="nav__cart" aria-label="Warenkorb">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M6 6h15l-1.5 9h-12L6 6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
							<path d="M6 6 5 3H2" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
							<circle cx="9" cy="20" r="1.4" fill="currentColor"></circle>
							<circle cx="17" cy="20" r="1.4" fill="currentColor"></circle>
						</svg>
						<span class="nav__cart-count" data-cart-count hidden></span>
					</a>
				</nav>
			</div>
		</header>

		<main class={wide ? "" : "container main-pad"}>
			<slot />
		</main>

		<!-- Footer -->
		<footer class="footer">
			<div class="footer__inner">
				<div class="footer__brand">
					<a href="/" class="brand brand--light">
						<span class="brand__mark">◆</span>
						<span>Peptide<span class="brand__accent">Einkaufen</span></span>
					</a>
					<p>
						Forschungspeptide für Analyse- und Laborzwecke mit klarer
						Produktdokumentation und diskretem Versand.
					</p>
				</div>

				<div class="footer__col">
					<h3>Shop</h3>
					<a href="/produkte">Alle Peptide</a>
					<a href="/kategorie/stoffwechsel-forschung">Stoffwechsel-Forschung</a>
					<a href="/kategorie/regenerationsforschung">Regenerationsforschung</a>
					<a href="/kategorie/neuropeptid-forschung">Neuropeptid-Forschung</a>
				</div>
				<div class="footer__col">
					<h3>Wissen</h3>
					<a href="/wissen">Grundlagen</a>
					<a href="/wissen/lexikon">Lexikon</a>
					<a href="/about">Über uns</a>
				</div>
				<div class="footer__col">
					<h3>Hinweise</h3>
					<a href="/contact">Kontakt / Support</a>
					<a href="/bestellung/suchen">Bestellung suchen</a>
					<a href="/contact">Versand &amp; Zahlung</a>
				</div>
				<div class="footer__col">
					<h3>Rechtliches</h3>
					<a href="/impressum">Impressum</a>
					<a href="/datenschutz">Datenschutz</a>
					<a href="/agb">AGB</a>
					<a href="/widerruf">Widerruf</a>
					{/* Consent must stay revocable, so the dialog needs a permanent
					    way back. A button rather than a link: it opens a dialog on
					    this page instead of navigating anywhere. Hidden entirely
					    when no analytics is configured, so it can never be dead. */}
					{ANALYTICS_ENABLED && (
						<button type="button" data-consent-open>Cookie-Einstellungen</button>
					)}
				</div>
			</div>
			<div class="footer__legal">
				<p>&copy; {BUILD_YEAR} Peptide Einkaufen</p>
				<p>Ausschließlich für Forschungs- und Laborzwecke. Nicht für den menschlichen Gebrauch.</p>
			</div>
		</footer>

		<script>
			// Keep the header cart badge in sync across pages and after any mutation.
			import { refresh, cartItemCount, CART_UPDATED_EVENT } from "../lib/cart";

			const badge = document.querySelector<HTMLElement>("[data-cart-count]");

			const paint = (cart: Parameters<typeof cartItemCount>[0]) => {
				if (!badge) return;
				const count = cartItemCount(cart);
				badge.textContent = String(count);
				badge.toggleAttribute("hidden", count === 0);
			};

			window.addEventListener(CART_UPDATED_EVENT, (event) => {
				paint((event as CustomEvent).detail);
			});

			refresh().catch(() => {
				/* No cart yet, or Medusa unreachable — leave the badge hidden. */
			});
		</script>

		<script>
			// The footer entry point back into the consent dialog. Dispatching the
			// event rather than reaching into the component keeps the layout
			// ignorant of how the dialog is built, and lets any page ask for it.
			import { requestConsentDialog } from "../lib/consent";

			document
				.querySelector("[data-consent-open]")
				?.addEventListener("click", () => requestConsentDialog());
		</script>

		<WebMCPTools />
		<ConsentBanner />

		<style is:global>
			:root {
				--c-navy: #15273f;
				--c-navy-deep: #101f33;
				--c-navy-2: #1d3654;
				--c-cream: #f5eddd;
				--c-cream-soft: #faf5ea;
				--c-mint: #e7f1ec;
				--c-blue-tint: #eaf0f6;
				--c-green: #2f7d5c;
				--c-green-dark: #276a4e;
				--c-gold: #d8b568;
				--c-ink: #15273f;
				--c-muted: #5b6b7d;
				--c-border: #e4e8ee;
				--c-white: #ffffff;

				/* Neutral surfaces (product media, input fields) */
				--c-surface: #f4f6f9;
				--c-surface-2: #eef1f5;
				--c-field: #f2f4f7;
				--c-cream-border: #ece3d2;

				/* Text on the navy backgrounds, lightest to dimmest. Six steps
				   because the footer and hero use distinct values; kept separate
				   so folding them into tokens changes nothing visually. */
				--c-on-navy-100: #d9e4f0;
				--c-on-navy-200: #c8d2df;
				--c-on-navy-300: #b9c6d6;
				--c-on-navy-400: #9fb0c4;
				--c-on-navy-500: #93a2b5;
				--c-on-navy-600: #7e8ea3;

				/* Text on the gold announcement bar */
				--c-gold-ink: #3a2f15;
				--c-gold-ink-soft: #5a4d33;

				/* Modal scrim, and the shadow cast onto it */
				--c-scrim: rgb(21 39 63 / 0.55);

				/* Status tones */
				--c-warn-bg: #f7f1e5;
				--c-warn-ink: #765627;
				--c-crit-bg: #f7e7e2;
				--c-crit-ink: #8e3b2b;

				--radius: 14px;
				--radius-sm: 10px;
				--container: 1120px;
				--font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI",
					Roboto, "Helvetica Neue", Arial, sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			/* Author `display` rules beat the UA stylesheet, so [hidden] alone does
			   not hide an element we also give a display value. */
			[hidden] {
				display: none !important;
			}

			html {
				-webkit-text-size-adjust: 100%;
			}

			body {
				margin: 0;
				font-family: var(--font-sans);
				color: var(--c-ink);
				background: var(--c-white);
				line-height: 1.55;
				-webkit-font-smoothing: antialiased;
			}

			h1, h2, h3 {
				line-height: 1.15;
				letter-spacing: -0.02em;
				margin: 0 0 0.5em;
			}

			a {
				color: inherit;
			}

			img {
				max-width: 100%;
			}

			.container {
				max-width: var(--container);
				margin-inline: auto;
				padding-inline: 1.5rem;
			}

			.main-pad {
				padding-block: 2.5rem 3.5rem;
			}

			/* Label text that screen readers and WebMCP agents need but the
			   layout has no room for. */
			.visually-hidden {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip: rect(0 0 0 0);
				white-space: nowrap;
			}

			/* Buttons */
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				border: none;
				border-radius: 999px;
				font-family: inherit;
				font-weight: 600;
				font-size: 0.95rem;
				padding: 0.7rem 1.4rem;
				cursor: pointer;
				text-decoration: none;
				transition: background-color 0.15s ease, color 0.15s ease;
			}
			.btn--green {
				background: var(--c-green);
				color: var(--c-white);
			}
			.btn--green:hover {
				background: var(--c-green-dark);
			}
			.btn--ghost {
				background: transparent;
				color: var(--c-white);
				box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.35);
			}
			.btn--ghost:hover {
				box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.7);
			}
			.btn--sm {
				padding: 0.5rem 1rem;
				font-size: 0.875rem;
			}

			.eyebrow {
				display: inline-block;
				background: var(--c-mint);
				color: var(--c-green-dark);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				padding: 0.3rem 0.7rem;
				border-radius: 999px;
				margin-bottom: 1rem;
			}
		</style>

		<style>
			/* Announcement bar */
			.announce {
				background: var(--c-gold);
				color: var(--c-gold-ink);
				font-size: 0.8rem;
				font-weight: 600;
			}
			.announce__inner {
				max-width: var(--container);
				margin-inline: auto;
				padding: 0.45rem 1.5rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
			}
			.announce a {
				text-decoration: none;
				opacity: 0.85;
			}
			.announce a:hover {
				opacity: 1;
			}

			/* Header */
			.header {
				background: var(--c-white);
				border-bottom: 1px solid var(--c-border);
				position: sticky;
				top: 0;
				z-index: 20;
			}
			.header__inner {
				max-width: var(--container);
				margin-inline: auto;
				padding: 0.9rem 1.5rem;
				display: flex;
				align-items: center;
				gap: 1.5rem;
			}
			.brand {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-weight: 800;
				font-size: 1.05rem;
				letter-spacing: -0.02em;
				text-decoration: none;
				color: var(--c-navy);
				white-space: nowrap;
			}
			.brand__mark {
				color: var(--c-green);
			}
			.brand__accent {
				color: var(--c-green);
			}
			.brand--light {
				color: var(--c-white);
			}

			.search {
				flex: 1;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				background: var(--c-field);
				border: 1px solid var(--c-border);
				border-radius: 999px;
				padding: 0.5rem 1rem;
				color: var(--c-muted);
				max-width: 420px;
			}
			.search input {
				border: none;
				background: transparent;
				outline: none;
				font-family: inherit;
				font-size: 0.9rem;
				color: var(--c-ink);
				width: 100%;
			}

			.nav {
				display: flex;
				align-items: center;
				gap: 1.3rem;
				margin-left: auto;
				font-size: 0.9rem;
				font-weight: 600;
			}
			.nav a {
				text-decoration: none;
				color: var(--c-navy);
			}
			.nav a:hover {
				color: var(--c-green);
			}
			.nav__cart {
				position: relative;
				display: inline-grid;
				place-items: center;
				width: 38px;
				height: 38px;
				border-radius: 999px;
				background: var(--c-navy);
				color: var(--c-white) !important;
			}
			.nav__cart-count {
				position: absolute;
				top: -4px;
				right: -4px;
				min-width: 18px;
				height: 18px;
				padding: 0 4px;
				border-radius: 999px;
				background: var(--c-green);
				color: var(--c-white);
				font-size: 0.68rem;
				font-weight: 700;
				display: grid;
				place-items: center;
			}

			@media (max-width: 820px) {
				.search {
					display: none;
				}
				.nav {
					gap: 0.9rem;
					font-size: 0.82rem;
				}
			}

			/* Footer */
			.footer {
				background: var(--c-navy-deep);
				color: var(--c-on-navy-200);
				margin-top: 4rem;
			}
			.footer__inner {
				max-width: var(--container);
				margin-inline: auto;
				padding: 3rem 1.5rem 2rem;
				display: grid;
				grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
				gap: 2rem;
			}
			.footer__brand p {
				font-size: 0.875rem;
				max-width: 30ch;
				color: var(--c-on-navy-500);
				margin-top: 0.75rem;
			}
			.footer__col h3 {
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--c-white);
				margin-bottom: 0.9rem;
			}
			/* The consent entry point is a button, but it belongs to this list
			   visually — so it is styled with the links, minus the UA defaults a
			   button brings along. */
			.footer__col a,
			.footer__col button {
				display: block;
				text-decoration: none;
				font-size: 0.875rem;
				color: var(--c-on-navy-500);
				padding: 0.25rem 0;
			}
			.footer__col button {
				background: none;
				border: none;
				font-family: inherit;
				text-align: left;
				cursor: pointer;
			}
			.footer__col a:hover,
			.footer__col button:hover {
				color: var(--c-white);
			}
			.footer__legal {
				max-width: var(--container);
				margin-inline: auto;
				padding: 1.25rem 1.5rem;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				display: flex;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.5rem;
				font-size: 0.78rem;
				color: var(--c-on-navy-600);
			}
			.footer__legal p {
				margin: 0;
			}

			@media (max-width: 720px) {
				.footer__inner {
					grid-template-columns: 1fr 1fr;
				}
			}
		</style>
	</body>
</html>
