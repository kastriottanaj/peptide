---
import Seo from "../components/Seo.astro";

export interface Props {
	title: string;
	description?: string;
	/** When true, the page renders full-bleed sections (homepage). Otherwise content sits in a centered container. */
	wide?: boolean;
	/** Omit the brand suffix from <title> (the homepage carries it already). */
	rawTitle?: boolean;
	ogType?: "website" | "article" | "product";
	image?: { url: string; alt: string; width?: number; height?: number };
	noindex?: boolean;
	/** Extra JSON-LD nodes merged into the page @graph. */
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description = "Peptide Kaufen Deutschland – Forschungspeptide für wissenschaftliche und laborinterne Zwecke.",
	wide = false,
	rawTitle = false,
	ogType = "website",
	image,
	noindex = false,
	jsonLd = [],
} = Astro.props;
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<Seo
			title={title}
			description={description}
			rawTitle={rawTitle}
			ogType={ogType}
			image={image}
			noindex={noindex}
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<!-- Announcement bar -->
		<div class="announce">
			<div class="announce__inner">
				<span>Analytisch geprüfte Forschungspeptide · Diskreter Versand</span>
				<a href="/contact">Support anfragen</a>
			</div>
		</div>

		<!-- Header -->
		<header class="header">
			<div class="header__inner">
				<a href="/" class="brand">
					<span class="brand__mark">◆</span>
					<span>Peptide<span class="brand__accent">KaufenDE</span></span>
				</a>

				<form class="search" action="/produkte" method="get" role="search">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
						<path d="m20 20-3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
					<input
						type="search"
						name="q"
						placeholder="Peptide suchen…"
						aria-label="Peptide suchen"
						autocomplete="off"
					/>
				</form>

				<nav class="nav">
					<a href="/produkte">Shop</a>
					<a href="/about">Wissen</a>
					<a href="/produkte">Zertifikate</a>
					<a href="/contact">Support</a>
					<a href="/produkte" class="nav__cart" aria-label="Warenkorb">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M6 6h15l-1.5 9h-12L6 6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
							<path d="M6 6 5 3H2" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
							<circle cx="9" cy="20" r="1.4" fill="currentColor"></circle>
							<circle cx="17" cy="20" r="1.4" fill="currentColor"></circle>
						</svg>
					</a>
				</nav>
			</div>
		</header>

		<main class={wide ? "" : "container main-pad"}>
			<slot />
		</main>

		<!-- Footer -->
		<footer class="footer">
			<div class="footer__inner">
				<div class="footer__brand">
					<a href="/" class="brand brand--light">
						<span class="brand__mark">◆</span>
						<span>Peptide<span class="brand__accent">KaufenDE</span></span>
					</a>
					<p>
						Forschungspeptide für Analyse- und Laborzwecke mit klarer
						Produktdokumentation und diskretem Versand.
					</p>
				</div>

				<div class="footer__col">
					<h3>Shop</h3>
					<a href="/produkte">Peptide ansehen</a>
					<a href="/produkte">Kategorien</a>
					<a href="/produkte">Bundles / Stacks</a>
				</div>
				<div class="footer__col">
					<h3>Wissen</h3>
					<a href="/about">Über uns</a>
					<a href="/about">Forschungsbereiche</a>
				</div>
				<div class="footer__col">
					<h3>Hinweise</h3>
					<a href="/contact">Kontakt / Support</a>
					<a href="/contact">Versand &amp; Zahlung</a>
				</div>
			</div>
			<div class="footer__legal">
				<p>&copy; {new Date().getFullYear()} Peptide Kaufen Deutschland</p>
				<p>Ausschließlich für Forschungs- und Laborzwecke. Nicht für den menschlichen Gebrauch.</p>
			</div>
		</footer>

		<style is:global>
			:root {
				--c-navy: #15273f;
				--c-navy-deep: #101f33;
				--c-navy-2: #1d3654;
				--c-cream: #f5eddd;
				--c-cream-soft: #faf5ea;
				--c-mint: #e7f1ec;
				--c-blue-tint: #eaf0f6;
				--c-green: #2f7d5c;
				--c-green-dark: #276a4e;
				--c-gold: #d8b568;
				--c-ink: #15273f;
				--c-muted: #5b6b7d;
				--c-border: #e4e8ee;
				--c-white: #ffffff;
				--radius: 14px;
				--radius-sm: 10px;
				--container: 1120px;
				--font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI",
					Roboto, "Helvetica Neue", Arial, sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			html {
				-webkit-text-size-adjust: 100%;
			}

			body {
				margin: 0;
				font-family: var(--font-sans);
				color: var(--c-ink);
				background: var(--c-white);
				line-height: 1.55;
				-webkit-font-smoothing: antialiased;
			}

			h1, h2, h3 {
				line-height: 1.15;
				letter-spacing: -0.02em;
				margin: 0 0 0.5em;
			}

			a {
				color: inherit;
			}

			img {
				max-width: 100%;
			}

			.container {
				max-width: var(--container);
				margin-inline: auto;
				padding-inline: 1.5rem;
			}

			.main-pad {
				padding-block: 2.5rem 3.5rem;
			}

			/* Buttons */
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				border: none;
				border-radius: 999px;
				font-family: inherit;
				font-weight: 600;
				font-size: 0.95rem;
				padding: 0.7rem 1.4rem;
				cursor: pointer;
				text-decoration: none;
				transition: background-color 0.15s ease, color 0.15s ease;
			}
			.btn--green {
				background: var(--c-green);
				color: #fff;
			}
			.btn--green:hover {
				background: var(--c-green-dark);
			}
			.btn--ghost {
				background: transparent;
				color: #fff;
				box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.35);
			}
			.btn--ghost:hover {
				box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.7);
			}
			.btn--sm {
				padding: 0.5rem 1rem;
				font-size: 0.875rem;
			}

			.eyebrow {
				display: inline-block;
				background: var(--c-mint);
				color: var(--c-green-dark);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				padding: 0.3rem 0.7rem;
				border-radius: 999px;
				margin-bottom: 1rem;
			}
		</style>

		<style>
			/* Announcement bar */
			.announce {
				background: var(--c-gold);
				color: #3a2f15;
				font-size: 0.8rem;
				font-weight: 600;
			}
			.announce__inner {
				max-width: var(--container);
				margin-inline: auto;
				padding: 0.45rem 1.5rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
			}
			.announce a {
				text-decoration: none;
				opacity: 0.85;
			}
			.announce a:hover {
				opacity: 1;
			}

			/* Header */
			.header {
				background: var(--c-white);
				border-bottom: 1px solid var(--c-border);
				position: sticky;
				top: 0;
				z-index: 20;
			}
			.header__inner {
				max-width: var(--container);
				margin-inline: auto;
				padding: 0.9rem 1.5rem;
				display: flex;
				align-items: center;
				gap: 1.5rem;
			}
			.brand {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-weight: 800;
				font-size: 1.05rem;
				letter-spacing: -0.02em;
				text-decoration: none;
				color: var(--c-navy);
				white-space: nowrap;
			}
			.brand__mark {
				color: var(--c-green);
			}
			.brand__accent {
				color: var(--c-green);
			}
			.brand--light {
				color: #fff;
			}

			.search {
				flex: 1;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				background: #f2f4f7;
				border: 1px solid var(--c-border);
				border-radius: 999px;
				padding: 0.5rem 1rem;
				color: var(--c-muted);
				max-width: 420px;
			}
			.search input {
				border: none;
				background: transparent;
				outline: none;
				font-family: inherit;
				font-size: 0.9rem;
				color: var(--c-ink);
				width: 100%;
			}

			.nav {
				display: flex;
				align-items: center;
				gap: 1.3rem;
				margin-left: auto;
				font-size: 0.9rem;
				font-weight: 600;
			}
			.nav a {
				text-decoration: none;
				color: var(--c-navy);
			}
			.nav a:hover {
				color: var(--c-green);
			}
			.nav__cart {
				display: inline-grid;
				place-items: center;
				width: 38px;
				height: 38px;
				border-radius: 999px;
				background: var(--c-navy);
				color: #fff !important;
			}

			@media (max-width: 820px) {
				.search {
					display: none;
				}
				.nav {
					gap: 0.9rem;
					font-size: 0.82rem;
				}
			}

			/* Footer */
			.footer {
				background: var(--c-navy-deep);
				color: #c8d2df;
				margin-top: 4rem;
			}
			.footer__inner {
				max-width: var(--container);
				margin-inline: auto;
				padding: 3rem 1.5rem 2rem;
				display: grid;
				grid-template-columns: 2fr 1fr 1fr 1fr;
				gap: 2rem;
			}
			.footer__brand p {
				font-size: 0.875rem;
				max-width: 30ch;
				color: #93a2b5;
				margin-top: 0.75rem;
			}
			.footer__col h3 {
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: #fff;
				margin-bottom: 0.9rem;
			}
			.footer__col a {
				display: block;
				text-decoration: none;
				font-size: 0.875rem;
				color: #93a2b5;
				padding: 0.25rem 0;
			}
			.footer__col a:hover {
				color: #fff;
			}
			.footer__legal {
				max-width: var(--container);
				margin-inline: auto;
				padding: 1.25rem 1.5rem;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				display: flex;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.5rem;
				font-size: 0.78rem;
				color: #7e8ea3;
			}
			.footer__legal p {
				margin: 0;
			}

			@media (max-width: 720px) {
				.footer__inner {
					grid-template-columns: 1fr 1fr;
				}
			}
		</style>
	</body>
</html>
