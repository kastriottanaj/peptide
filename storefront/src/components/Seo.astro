---
/**
 * Per-page metadata: title, description, canonical, OpenGraph, Twitter and the
 * JSON-LD @graph. Rendered from BaseLayout so no page hand-rolls head tags.
 */
import {
	SITE_NAME,
	SITE_LOCALE,
	canonicalFrom,
	organizationNode,
} from "../lib/site";

export interface Props {
	/** Page title without the brand suffix. */
	title: string;
	description: string;
	/** Omit the brand suffix (used on the homepage, which carries it already). */
	rawTitle?: boolean;
	ogType?: "website" | "article" | "product";
	image?: { url: string; alt: string; width?: number; height?: number };
	noindex?: boolean;
	/** Extra JSON-LD nodes; the Organization node is always included. */
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description,
	rawTitle = false,
	ogType = "website",
	image,
	noindex = false,
	jsonLd = [],
} = Astro.props;

const fullTitle = rawTitle ? title : `${title} | ${SITE_NAME}`;
const canonical = canonicalFrom(Astro.url);

/**
 * Google Search Console ownership token, for the meta-tag verification method.
 *
 * Unset by default, and deliberately not the route used today: the storefront
 * sits behind HTTP basic auth (deploy/Caddyfile), so Googlebot receives 401 for
 * every URL and can never read this tag. Verification currently runs over a DNS
 * TXT record instead — see docs/analytics.md. This exists for a URL-prefix
 * property added after the gate comes off.
 */
const googleSiteVerification: string =
	import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? "";

const graph = {
	"@context": "https://schema.org",
	"@graph": [organizationNode(), ...jsonLd],
};

/**
 * Serialise the graph for a `<script>` body.
 *
 * `JSON.stringify` escapes quotes and backslashes but leaves `<`, `>` and `&`
 * alone, and `set:html` does not escape either — so a value containing
 * `</script>` closes this tag and everything after it is parsed as markup. The
 * values here are product titles and descriptions from the Medusa admin plus
 * markdown frontmatter, i.e. text that is edited, not code: nothing upstream
 * stops someone pasting a tag into a product description, and it would then
 * execute on every page that product appears on.
 *
 * Escaping them as `\uXXXX` is invisible to JSON parsers (identical value) but
 * makes the closing sequence unwritable. U+2028/U+2029 are valid in JSON yet
 * illegal raw in JS string literals, so they are escaped too for any consumer
 * that evaluates rather than parses.
 */
function serializeJsonLd(value: unknown): string {
	return JSON.stringify(value)
		.replace(/</g, "\\u003c")
		.replace(/>/g, "\\u003e")
		.replace(/&/g, "\\u0026")
		.replace(/\u2028/g, "\\u2028")
		.replace(/\u2029/g, "\\u2029");
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{
	googleSiteVerification && (
		<meta name="google-site-verification" content={googleSiteVerification} />
	)
}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={SITE_LOCALE} />
{
	image && (
		<>
			<meta property="og:image" content={image.url} />
			<meta property="og:image:alt" content={image.alt} />
			{image.width && <meta property="og:image:width" content={String(image.width)} />}
			{image.height && <meta property="og:image:height" content={String(image.height)} />}
		</>
	)
}

<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image.url} />}

<script
	type="application/ld+json"
	is:inline
	set:html={serializeJsonLd(graph)}
/>
