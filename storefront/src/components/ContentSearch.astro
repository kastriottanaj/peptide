---
/**
 * Client-side search over content that is already rendered on the page.
 *
 * The storefront builds to static HTML, so `?q=` cannot be resolved at build
 * time — the approach `/produkte` takes applies here too: every item ships in
 * the markup with a pre-folded haystack in `data-search`, and this script only
 * toggles `hidden`. No result is fetched, so the filter works offline and costs
 * one small module.
 *
 * A page opts in with three attributes:
 *
 *   data-search-item   a filterable item, carrying data-search="<folded text>"
 *   data-search-group  a section hidden once none of its items match, so a
 *                      filtered page never shows a heading over nothing
 *   data-search-aside  content hidden while a query is active (an A–Z jump nav
 *                      or a teaser block that is not itself a result)
 */
export interface Props {
	/** Visually hidden label for the input. */
	label: string;
	placeholder: string;
	/** Result-count nouns, e.g. "Eintrag" / "Einträge". */
	nounSingular: string;
	nounPlural: string;
}

const { label, placeholder, nounSingular, nounPlural } = Astro.props;
---

<div
	class="search"
	data-search-root
	data-noun-singular={nounSingular}
	data-noun-plural={nounPlural}
>
	<label class="search__field">
		<span class="visually-hidden">{label}</span>
		<input
			type="search"
			name="q"
			placeholder={placeholder}
			autocomplete="off"
			enterkeyhint="search"
			data-search-input
		/>
	</label>
	<button type="button" class="search__clear" data-search-clear hidden>
		Suche zurücksetzen
	</button>
</div>

<p class="search__status" data-search-status role="status" aria-live="polite" hidden></p>

<script>
	import { searchTerms } from "../lib/search";

	const root = document.querySelector<HTMLElement>("[data-search-root]");
	const input = document.querySelector<HTMLInputElement>("[data-search-input]");

	if (root && input) {
		const items = Array.from(
			document.querySelectorAll<HTMLElement>("[data-search-item]"),
		);
		const groups = Array.from(
			document.querySelectorAll<HTMLElement>("[data-search-group]"),
		);
		const asides = Array.from(
			document.querySelectorAll<HTMLElement>("[data-search-aside]"),
		);
		const statusEl = document.querySelector<HTMLElement>("[data-search-status]");
		const clearButton =
			document.querySelector<HTMLButtonElement>("[data-search-clear]");
		const nounSingular = root.dataset.nounSingular ?? "Treffer";
		const nounPlural = root.dataset.nounPlural ?? "Treffer";

		const apply = (raw: string, updateUrl: boolean) => {
			const query = raw.trim();
			const terms = searchTerms(query);
			const filtering = terms.length > 0;
			let visible = 0;

			for (const item of items) {
				const haystack = item.dataset.search ?? "";
				const match = !filtering || terms.every((term) => haystack.includes(term));
				item.toggleAttribute("hidden", !match);
				if (match) visible++;
			}

			// Hide a group only after its items have been resolved above, otherwise
			// the heading survives its last result.
			for (const group of groups) {
				const hasMatch = group.querySelector("[data-search-item]:not([hidden])");
				group.toggleAttribute("hidden", hasMatch === null);
			}
			for (const aside of asides) {
				aside.toggleAttribute("hidden", filtering);
			}

			clearButton?.toggleAttribute("hidden", !filtering);
			if (statusEl) {
				statusEl.toggleAttribute("hidden", !filtering);
				if (filtering) {
					// textContent, not innerHTML: the query is user input echoed back.
					statusEl.textContent =
						visible === 0
							? `Keine Treffer für „${query}“.`
							: `${visible} ${visible === 1 ? nounSingular : nounPlural} für „${query}“`;
				}
			}

			if (updateUrl) {
				const url = new URL(window.location.href);
				if (filtering) url.searchParams.set("q", query);
				else url.searchParams.delete("q");
				window.history.replaceState({}, "", url);
			}

			// A filtered listing is a faceted near-duplicate of the clean URL. Static
			// output cannot vary the meta tag per query string, so set it here; the
			// canonical already points at the unfiltered path.
			let robots = document.querySelector<HTMLMetaElement>('meta[name="robots"]');
			if (filtering) {
				if (!robots) {
					robots = document.createElement("meta");
					robots.name = "robots";
					document.head.appendChild(robots);
				}
				robots.content = "noindex, follow";
			} else {
				robots?.remove();
			}
		};

		// Honour a deep-linked ?q= without pushing the same value straight back.
		const initial = new URLSearchParams(window.location.search).get("q") ?? "";
		input.value = initial;
		input.addEventListener("input", () => apply(input.value, true));
		clearButton?.addEventListener("click", () => {
			input.value = "";
			apply("", true);
			input.focus();
		});
		if (initial) apply(initial, false);
	}
</script>

<style>
	.search {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		margin-bottom: 0.75rem;
	}
	.search__field {
		flex: 1;
		max-width: 420px;
	}
	.search__field input {
		width: 100%;
		padding: 0.6rem 0.9rem;
		border: 1px solid var(--c-border);
		border-radius: 999px;
		font-family: inherit;
		font-size: 0.9rem;
		color: var(--c-ink);
		background: var(--c-field);
	}
	.search__field input:focus-visible {
		outline: 2px solid var(--c-green);
		outline-offset: 1px;
	}
	.search__clear {
		border: none;
		background: transparent;
		color: var(--c-muted);
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		text-decoration: underline;
	}
	.search__status {
		margin: 0 0 1.5rem;
		font-size: 0.85rem;
		color: var(--c-muted);
	}
	/* `.visually-hidden` comes from BaseLayout's global block, which is on every
	   page this component can appear on — a scoped copy only duplicated it. */
</style>
