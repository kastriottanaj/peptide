---
import type { HttpTypes } from "@medusajs/types";
import { isProductAvailable, isVariantAvailable } from "../lib/catalog";
import { productPath } from "../lib/links";
import { productImageAlt } from "../lib/product-image-alt";

interface Props {
	product: HttpTypes.StoreProduct;
	/**
	 * Whether this card is inside the first viewport when the page loads.
	 *
	 * The card cannot work this out for itself — the same component sits below a
	 * full-height hero on the homepage and directly under the `<h1>` on the
	 * listing and category pages — and DOM order is not the answer either, since
	 * the grid is responsive. So the page that lays the cards out declares it,
	 * and the default is the safe one: lazy.
	 *
	 * Measured at 1366×900 and 390×844: on `/produkte/` and `/kategorie/*` the
	 * first grid row starts ~80 px down, well inside the fold; on `/` the row
	 * starts at ~937 px (desktop) and ~1846 px (mobile), below it on both.
	 */
	aboveTheFold?: boolean;
}

const { product, aboveTheFold = false } = Astro.props;

// Peptide-specific attributes live in product.metadata. They are optional:
// the card degrades gracefully when a value is missing so it works for any
// catalog (including the current Medusa demo data, which has no peptide fields).
const meta = (product.metadata ?? {}) as Record<string, unknown>;
const researchCode =
	typeof meta.research_code === "string" ? meta.research_code : null;
const purity = typeof meta.purity === "string" ? meta.purity : null;

const variants = product.variants ?? [];

// "Dosage" line: for peptides the variant title is the pack size (e.g. "10 mg").
const dosage = variants[0]?.title ?? null;

function lowestPrice() {
	// The card advertises "ab <price>", so it must quote a pack size the customer
	// can actually order. A sold-out cheaper size would otherwise set the
	// headline price for a product that cannot be bought at it.
	const purchasable = variants.filter(isVariantAvailable);
	const priced = (purchasable.length ? purchasable : variants)
		.map((v) => ({
			amount: v.calculated_price?.calculated_amount,
			currency: v.calculated_price?.currency_code ?? "eur",
		}))
		.filter((p): p is { amount: number; currency: string } => typeof p.amount === "number");
	if (!priced.length) return null;
	const min = priced.reduce((a, b) => (a.amount <= b.amount ? a : b));
	return new Intl.NumberFormat("de-DE", {
		style: "currency",
		currency: min.currency.toUpperCase(),
	}).format(min.amount);
}

const price = lowestPrice();
const available = isProductAvailable(product);
---

<article class="pcard">
	<a href={productPath(product.handle)} class="pcard__link">
		<div class="pcard__media">
			{researchCode && <span class="pcard__code">{researchCode}</span>}
			{purity && <span class="pcard__purity">{purity}</span>}
			{
				product.thumbnail ? (
					/*
					 * `.pcard__media` is `aspect-ratio: 1 / 1`, so the box is reserved
					 * before the image arrives and lazy loading costs no layout shift.
					 * width/height stay as the intrinsic ratio for anything that reads
					 * the attributes rather than the stylesheet.
					 */
					<img
						src={product.thumbnail}
						alt={productImageAlt(product, "card")}
						loading={aboveTheFold ? "eager" : "lazy"}
						decoding="async"
						width="220"
						height="220"
					/>
				) : (
					<svg class="pcard__vial" viewBox="0 0 80 100" aria-hidden="true">
						<rect x="30" y="6" width="20" height="10" rx="2" fill="#c9d3df" />
						<path d="M28 16h24v70a12 12 0 0 1-24 0V16Z" fill="#d9a441" opacity="0.85" />
						<path d="M28 58h24v28a12 12 0 0 1-24 0V58Z" fill="#b9862f" opacity="0.6" />
						<rect x="34" y="24" width="12" height="26" rx="2" fill="#fff" opacity="0.35" />
					</svg>
				)
			}
		</div>

		<div class="pcard__body">
			<h3 class="pcard__title">{product.title}</h3>
			{dosage && <p class="pcard__dosage">{dosage}</p>}

			<div class="pcard__foot">
				<div>
					{price && <p class="pcard__price">{price}</p>}
					{
						available && (
							<p class="pcard__stock">
								<span class="dot" />
								Verfügbar
							</p>
						)
					}
				</div>
				<span class="btn btn--green btn--sm pcard__cta">Anzeigen</span>
			</div>
		</div>
	</a>
</article>

<style>
	.pcard {
		background: var(--c-white);
		border: 1px solid var(--c-border);
		border-radius: var(--radius);
		overflow: hidden;
		transition: box-shadow 0.15s ease, transform 0.15s ease;
	}
	.pcard:hover {
		box-shadow: 0 10px 28px rgba(21, 39, 63, 0.1);
		transform: translateY(-2px);
	}
	.pcard__link {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.pcard__media {
		position: relative;
		aspect-ratio: 1 / 1;
		background: linear-gradient(180deg, var(--c-surface), var(--c-surface-2));
		display: grid;
		place-items: center;
		padding: 1rem;
	}
	.pcard__media img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		mix-blend-mode: multiply;
	}
	.pcard__vial {
		width: 55%;
		height: 80%;
	}
	.pcard__code {
		position: absolute;
		top: 0.7rem;
		left: 0.7rem;
		background: var(--c-navy);
		color: var(--c-white);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		padding: 0.25rem 0.5rem;
		border-radius: 6px;
	}
	.pcard__purity {
		position: absolute;
		top: 0.7rem;
		right: 0.7rem;
		background: var(--c-mint);
		color: var(--c-green-dark);
		font-size: 0.66rem;
		font-weight: 700;
		padding: 0.25rem 0.5rem;
		border-radius: 6px;
	}
	.pcard__body {
		padding: 0.9rem 1rem 1.1rem;
	}
	.pcard__title {
		font-size: 1rem;
		font-weight: 700;
		margin: 0;
	}
	.pcard__dosage {
		margin: 0.15rem 0 0;
		font-size: 0.82rem;
		color: var(--c-muted);
	}
	.pcard__foot {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.9rem;
	}
	.pcard__price {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 800;
		color: var(--c-navy);
	}
	.pcard__stock {
		margin: 0.2rem 0 0;
		font-size: 0.76rem;
		color: var(--c-green-dark);
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.pcard__stock .dot {
		width: 7px;
		height: 7px;
		border-radius: 999px;
		background: var(--c-green);
	}
</style>
