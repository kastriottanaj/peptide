---
/**
 * Informationspflichten nach Art. 13/14 DSGVO.
 *
 * WICHTIG: Dieser Text beschreibt bewusst nur die Verarbeitungen, die im Shop
 * tatsächlich stattfinden. Sections branch on `ANALYTICS_ENABLED` and on the
 * configured contact channels: a build without `PUBLIC_GA_MEASUREMENT_ID` loads
 * no Google script at all, and a privacy policy claiming otherwise would be
 * wrong in the direction that matters. Any further service added here needs its
 * own section and its own consent category — see `src/lib/consent.ts`.
 *
 * The page stays `draft` (and therefore `noindex`) while the controller's
 * identity, the hosting processing agreement and the shipping provider are
 * open. Do not remove the flag to satisfy an SEO audit — see
 * docs/go-live-checklist.md §2 and §4.
 */
import LegalLayout from "../layouts/LegalLayout.astro";
import type { LegalSection } from "../layouts/LegalLayout.astro";
import { ANALYTICS_ENABLED } from "../lib/analytics";
import { CONTACT } from "../lib/company";

/**
 * The storage keys named in section 3, so a reader can find and delete them.
 * Defined in `lib/cart.ts` (`CART_ID_KEY`) and `lib/consent.ts` (`STORAGE_KEY`,
 * versioned by `CONSENT_VERSION`); repeated here as the visible values.
 */
const CART_STORAGE_KEY = "peptide_cart_id";
const CONSENT_STORAGE_KEY = "pe_consent_v1";

// One object per section, used both for the table of contents and for the
// heading itself, so an anchor cannot outlive the heading it points at.
const S = {
	controller: { id: "verantwortlicher", heading: "1. Verantwortlicher" },
	hosting: { id: "hosting", heading: "2. Aufruf der Website und Hosting" },
	storage: { id: "lokale-speicherung", heading: "3. Warenkorb und lokale Speicherung" },
	account: { id: "kein-kundenkonto", heading: "4. Kein Kundenkonto" },
	order: { id: "bestellung", heading: "5. Bestellung und Vertragsabwicklung" },
	payment: { id: "zahlung", heading: "6. Zahlung per Banküberweisung" },
	lookup: { id: "bestellungssuche", heading: "7. Bestellungssuche" },
	support: { id: "kontaktaufnahme", heading: "8. Kontaktaufnahme" },
	inbox: {
		id: "support-postfach",
		heading: "9. Verarbeitung von Support-E-Mails im internen Verwaltungssystem",
	},
	recipients: { id: "empfaenger", heading: "10. Empfänger und Drittlandsübermittlung" },
	retention: { id: "speicherdauer", heading: "11. Speicherdauer" },
	analytics: { id: "analyse", heading: "12. Analyse und Tracking" },
	rights: { id: "rechte", heading: "13. Ihre Rechte" },
	complaint: { id: "beschwerde", heading: "14. Beschwerderecht" },
	required: { id: "erforderlichkeit", heading: "15. Erforderlichkeit der Angaben" },
} as const satisfies Record<string, LegalSection>;

const SECTIONS: LegalSection[] = Object.values(S);
---

<LegalLayout
	title="Datenschutzerklärung"
	description="Informationen zur Verarbeitung personenbezogener Daten nach Art. 13 DSGVO — Hosting, Bestellung, Zahlung, Analyse und Ihre Rechte."
	sections={SECTIONS}
	draft
>
	<h2 id={S.controller.id}>{S.controller.heading}</h2>
	<p>Verantwortlich für die Datenverarbeitung auf dieser Website ist:</p>
	<dl>
		<dt>Anbieter</dt>
		<dd><span class="todo">[Firmierung inkl. Rechtsform]</span></dd>
		<dt>Anschrift</dt>
		<dd><span class="todo">[Anschrift wie im Impressum]</span></dd>
		<dt>E-Mail</dt>
		<dd>
			{
				CONTACT.email ? (
					<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
				) : (
					<span class="todo">[E-Mail-Adresse]</span>
				)
			}
		</dd>
	</dl>
	<p class="todo">
		[Prüfen, ob ein Datenschutzbeauftragter benannt werden muss (Art. 37 DSGVO,
		§ 38 BDSG) — falls ja, Kontaktdaten hier ergänzen.]
	</p>

	<h2 id={S.hosting.id}>{S.hosting.heading}</h2>
	<p>
		Beim Aufruf unserer Seiten verarbeitet der Hosting-Anbieter technisch
		notwendige Verbindungsdaten (IP-Adresse, Datum und Uhrzeit, aufgerufene
		Adresse, übertragene Datenmenge, Browser- und Betriebssystemangaben). Diese
		Verarbeitung ist zum sicheren und stabilen Betrieb der Website erforderlich.
	</p>
	<p>
		Die Website wird auf einem Server der <strong>Hetzner Online GmbH</strong> in
		einem Rechenzentrum in Deutschland betrieben. Eine Übermittlung dieser
		Verbindungsdaten außerhalb der Europäischen Union findet dabei nicht statt.
	</p>
	<p>
		<strong>Rechtsgrundlage:</strong> Art. 6 Abs. 1 lit. f DSGVO (berechtigtes
		Interesse am technisch fehlerfreien Betrieb).{" "}
		<span class="todo"
			>[Vollständige Anschrift der Hetzner Online GmbH aus deren Impressum
			übernehmen und den Auftragsverarbeitungsvertrag nach Art. 28 DSGVO
			abschließen, bevor diese Seite veröffentlicht wird.]</span
		>
	</p>

	<h2 id={S.storage.id}>{S.storage.heading}</h2>
	<p>
		Diese Website setzt <strong>keine Cookies zu Werbe- oder Trackingzwecken</strong
		>. Im lokalen Speicher (localStorage) Ihres Browsers legen wir lediglich zwei
		Einträge ab:
	</p>
	<dl class="legal-facts">
		<dt><code>{CART_STORAGE_KEY}</code></dt>
		<dd>
			eine zufällige Kennung Ihres Warenkorbs, damit dieser beim Seitenwechsel
			erhalten bleibt. Sie enthält keine personenbezogenen Daten.
		</dd>
		<dt><code>{CONSENT_STORAGE_KEY}</code></dt>
		<dd>
			Ihre Entscheidung über die Statistik-Einwilligung samt Zeitpunkt, damit wir
			sie beachten und Sie nicht bei jedem Aufruf erneut fragen.
		</dd>
	</dl>
	<p>
		Beide Einträge verbleiben in Ihrem Browser, werden nicht an uns übertragen und
		können jederzeit über die Einstellungen Ihres Browsers gelöscht werden.
	</p>
	<p>
		<strong>Rechtsgrundlage:</strong> § 25 Abs. 2 Nr. 2 TDDDG (unbedingt
		erforderlich), Art. 6 Abs. 1 lit. f DSGVO. Für die Speicherung Ihrer
		Einwilligungsentscheidung besteht zudem eine Nachweispflicht nach Art. 7
		Abs. 1 DSGVO.
	</p>

	<h2 id={S.account.id}>{S.account.heading}</h2>
	<p>
		Der Shop führt <strong>keine Kundenkonten</strong>. Es gibt keine
		Registrierung, keine Anmeldung und kein Passwort, das wir speichern könnten.
		Bestellt wird als Gast; die dabei angegebenen Daten verarbeiten wir
		ausschließlich für die jeweilige Bestellung.
	</p>

	<h2 id={S.order.id}>{S.order.heading}</h2>
	<p>
		Zur Bearbeitung Ihrer Bestellung verarbeiten wir die von Ihnen angegebenen
		Daten: Vor- und Nachname, E-Mail-Adresse, Rechnungs- und Lieferanschrift,
		optional Telefonnummer, Firma und Umsatzsteuer-Identifikationsnummer sowie
		die Angaben zu den bestellten Artikeln.
	</p>
	<p>
		<strong>Rechtsgrundlage:</strong> Art. 6 Abs. 1 lit. b DSGVO (Erfüllung des
		Vertrags bzw. vorvertragliche Maßnahmen). Für die anschließende Aufbewahrung
		der Rechnungsdaten zusätzlich Art. 6 Abs. 1 lit. c DSGVO (handels- und
		steuerrechtliche Pflichten).
	</p>

	<h2 id={S.payment.id}>{S.payment.heading}</h2>
	<p>
		Die Zahlung erfolgt ausschließlich per Vorkasse durch Banküberweisung. Ein
		Zahlungsdienstleister ist nicht zwischengeschaltet. Wir erhalten von Ihrer
		Bank die zur Zuordnung der Zahlung erforderlichen Angaben, insbesondere Name
		des Kontoinhabers, Betrag und den von uns vergebenen Verwendungszweck.
		Kreditkarten- oder sonstige Zahlungsdaten verarbeiten wir nicht und erheben
		sie auch nicht im Bestellvorgang.
	</p>
	<p><strong>Rechtsgrundlage:</strong> Art. 6 Abs. 1 lit. b DSGVO.</p>

	<h2 id={S.lookup.id}>{S.lookup.heading}</h2>
	<p>
		Über die Seite <a href="/bestellung/suchen/">Bestellung suchen</a> können Sie
		Betrag und Verwendungszweck einer bereits aufgegebenen Bestellung erneut
		abrufen. Dazu übermitteln Sie Ihre Bestellnummer bzw. den Verwendungszweck
		zusammen mit der bei der Bestellung angegebenen E-Mail-Adresse. Beide Angaben
		werden nur zum Abgleich mit dem vorhandenen Bestelldatensatz verwendet, nicht
		gesondert gespeichert und nicht für andere Zwecke ausgewertet. Stimmen sie
		nicht überein, erhalten Sie eine allgemeine Fehlermeldung, die keine
		Rückschlüsse darauf zulässt, welche der beiden Angaben abweicht.
	</p>
	<p>
		<strong>Rechtsgrundlage:</strong> Art. 6 Abs. 1 lit. b DSGVO
		(Vertragsabwicklung).
	</p>

	<h2 id={S.support.id}>{S.support.heading}</h2>
	{
		CONTACT.any ? (
			<Fragment>
				<p>
					Wenn Sie uns über die auf der <a href="/contact/">Kontaktseite</a>{" "}
					genannten Wege schreiben oder anrufen, verarbeiten wir Ihre Angaben
					ausschließlich zur Bearbeitung Ihres Anliegens und für den Fall von
					Anschlussfragen. Ein Kontaktformular setzen wir nicht ein; es gibt
					daher auch keine Übermittlung an einen Formulardienst.
				</p>
				<p>
					<strong>Rechtsgrundlage:</strong> Art. 6 Abs. 1 lit. b DSGVO, soweit
					Ihr Anliegen einen Vertrag betrifft, sonst Art. 6 Abs. 1 lit. f DSGVO
					(berechtigtes Interesse an der Beantwortung von Anfragen).
				</p>
			</Fragment>
		) : (
			<p>
				Ein Kontaktformular setzen wir nicht ein, und es sind derzeit keine
				Kontaktwege für den Kundenkontakt veröffentlicht. Es findet daher
				gegenwärtig keine Verarbeitung von Daten aus einer Kontaktaufnahme
				statt. Sobald Kontaktwege veröffentlicht werden, wird die Verarbeitung
				der dort eingehenden Nachrichten an dieser Stelle beschrieben.
			</p>
		)
	}

	<h2 id={S.inbox.id}>{S.inbox.heading}</h2>
	<p>
		E-Mails an{" "}
		{CONTACT.email ? (
			<Fragment>
				unsere Support-Adresse <strong>{CONTACT.email}</strong>
			</Fragment>
		) : (
			"unser Support-Postfach"
		)}{" "}
		gehen im E-Mail-Postfach unseres E-Mail-Anbieters Hostinger ein und
		verbleiben dort. Zusätzlich werden sie über eine ausschließlich lesende
		IMAP-Verbindung in unser internes, passwortgeschütztes Verwaltungssystem
		(Medusa Admin) importiert. Der Import verändert das Postfach nicht:
		Nachrichten werden dort weder gelöscht noch verschoben, und ihr
		Gelesen-Status bleibt unverändert.
	</p>

	<p><strong>Welche Daten dabei gespeichert werden:</strong></p>
	<ul>
		<li>
			Absender- und Empfängerangaben, also die E-Mail-Adressen und — soweit in
			der Nachricht enthalten — die angegebenen Namen,
		</li>
		<li>der Betreff der Nachricht,</li>
		<li>Zeitstempel, insbesondere der Zeitpunkt des Eingangs,</li>
		<li>
			technische Kennungen zur Zuordnung von Nachrichten (Message-ID sowie die
			Verweise auf vorherige Nachrichten desselben Verlaufs),
		</li>
		<li>der Nachrichtentext in bereinigter Form als reiner Text,</li>
		<li>
			der Bearbeitungsstand in unserem System, also gelesen oder ungelesen, die
			Zuordnung zu einem Vorgang und dessen Status (offen, erledigt oder als
			Spam gekennzeichnet),
		</li>
		<li>Metadaten zu Anhängen, nämlich Dateiname, Dateityp und Dateigröße.</li>
	</ul>

	<p>
		<strong>Was ausdrücklich nicht verarbeitet wird:</strong> HTML-Inhalte von
		E-Mails werden weder gespeichert noch dargestellt. Bilder, Zählpixel und
		sonstige Inhalte von fremden Servern werden dabei nicht geladen. Die Inhalte
		von Anhängen werden nicht heruntergeladen, nicht gespeichert und nicht
		angezeigt; erfasst werden ausschließlich die oben genannten Metadaten.
	</p>

	<p>
		<strong>Zwecke:</strong> Bearbeitung und Dokumentation Ihres Anliegens,
		Abwicklung und Nachweis vertraglicher Vorgänge, Bearbeitung von Anfragen zum
		Datenschutz sowie Beantwortung technischer Anfragen und technische
		Verwaltung des Postfachs.
	</p>

	<p>
		<strong>Rechtsgrundlage:</strong> Art. 6 Abs. 1 lit. b DSGVO, soweit Ihr
		Anliegen einen Vertrag oder dessen Anbahnung betrifft; im Übrigen Art. 6
		Abs. 1 lit. f DSGVO (berechtigtes Interesse an der Beantwortung allgemeiner
		Support-Anfragen und an der technischen Verwaltung des Postfachs).{" "}
		<span class="todo">
			[Entwurf — die Angabe der Rechtsgrundlagen steht unter dem Vorbehalt der
			rechtlichen Prüfung.]
		</span>
	</p>

	<p>
		<strong>Speicherdauer:</strong> Wir speichern diese Nachrichten nur so lange,
		wie es für die Bearbeitung Ihres Anliegens und für etwaige Anschlussfragen
		erforderlich ist, sowie darüber hinaus, soweit gesetzliche
		Aufbewahrungspflichten bestehen (siehe Abschnitt 11). Eine automatische
		Löschung nach einer festen Frist ist derzeit nicht eingerichtet.
	</p>

	<p>
		Zugriff auf das Verwaltungssystem haben ausschließlich berechtigte,
		angemeldete Administratoren. Eine automatisierte Entscheidungsfindung
		einschließlich Profiling findet nicht statt.
	</p>

	<h2 id={S.recipients.id}>{S.recipients.heading}</h2>
	<p>Personenbezogene Daten geben wir weiter an:</p>
	<ul>
		<li>
			das von Ihnen und uns eingesetzte Kreditinstitut zur Abwicklung der
			Zahlung,
		</li>
		<li>
			das mit dem Versand beauftragte Logistikunternehmen, soweit dies zur
			Lieferung erforderlich ist{" "}
			<span class="todo">[Versanddienstleister benennen]</span>,
		</li>
		<li>
			die Hetzner Online GmbH als Hosting-Anbieterin, weisungsgebunden im Rahmen
			einer Auftragsverarbeitung nach Art. 28 DSGVO,
		</li>
		<li>
			die Hostinger als Anbieterin unseres E-Mail-Postfachs, weisungsgebunden im
			Rahmen einer Auftragsverarbeitung nach Art. 28 DSGVO (siehe Abschnitt 9){" "}
			<span class="todo">
				[Auftragsverarbeitungsvertrag mit dem E-Mail-Anbieter prüfen und die
				vollständige Firmierung ergänzen]
			</span>,
		</li>
		<li>
			Steuerberatung und Finanzbehörden, soweit wir gesetzlich zur Vorlage
			verpflichtet sind.
		</li>
		{
			ANALYTICS_ENABLED && (
				<li>
					die Google Ireland Limited als Anbieterin von Google Analytics,
					weisungsgebunden im Rahmen einer Auftragsverarbeitung nach
					Art. 28 DSGVO — aber nur, wenn Sie in die Statistik-Auswertung
					eingewilligt haben (siehe Abschnitt 12).
				</li>
			)
		}
	</ul>
	<p>
		Eine Weitergabe zu Werbezwecken findet nicht statt. Adresshandel, Scoring und
		eine automatisierte Entscheidungsfindung einschließlich Profiling setzen wir
		nicht ein.
	</p>
	{
		ANALYTICS_ENABLED ? (
			<p>
				Im Rahmen von Google Analytics können Daten auch an die Google LLC in
				den USA übermittelt werden. Diese Übermittlung findet ausschließlich
				auf Grundlage Ihrer Einwilligung statt und unterbleibt vollständig,
				solange Sie nicht eingewilligt haben.{" "}
				<span class="todo">
					[Aktuelle Übermittlungsgrundlage zum Zeitpunkt des Launch prüfen und
					hier benennen — Angemessenheitsbeschluss EU-US Data Privacy Framework
					(Art. 45 DSGVO) und/oder Standardvertragsklauseln (Art. 46 Abs. 2
					lit. c DSGVO). Der Status des DPF ist gerichtlich angegriffen; die
					Angabe muss bei der rechtlichen Prüfung bestätigt werden.]
				</span>
			</p>
		) : (
			<p>Eine Übermittlung in Drittländer findet nicht statt.</p>
		)
	}

	<h2 id={S.retention.id}>{S.retention.heading}</h2>
	<p>
		Wir speichern Ihre Daten, solange dies zur Vertragsabwicklung erforderlich
		ist. Darüber hinaus bewahren wir Bestell- und Rechnungsdaten aufgrund
		handels- und steuerrechtlicher Pflichten auf (§ 257 HGB, § 147 AO);
		die Aufbewahrungsfristen betragen dort sechs bzw. zehn Jahre. Nach Ablauf
		dieser Fristen löschen wir die Daten.
	</p>
	<p>
		Ihre Einwilligungsentscheidung verbleibt bis zu einem Widerruf oder bis zum
		Löschen des lokalen Speichers in Ihrem Browser; die Einträge aus Abschnitt 3
		werden nicht an uns übertragen.
	</p>

	<h2 id={S.analytics.id}>{S.analytics.heading}</h2>
	{
		ANALYTICS_ENABLED ? (
			<Fragment>
				<p>
					Wir verwenden Google Analytics 4, einen Webanalysedienst der Google
					Ireland Limited, Gordon House, Barrow Street, Dublin 4, Irland
					(„Google“). Damit werten wir aus, wie unsere Website genutzt wird,
					um sie zu verbessern.
				</p>
				<p>
					<strong>
						Die Auswertung findet ausschließlich nach Ihrer ausdrücklichen
						Einwilligung statt.
					</strong>{" "}
					Rechtsgrundlage ist Art. 6 Abs. 1 lit. a DSGVO in Verbindung mit
					§ 25 Abs. 1 TTDSG. Solange Sie nicht eingewilligt haben, wird kein
					Google-Skript geladen, kein Cookie gesetzt und keine Verbindung zu
					Google hergestellt.
				</p>
				<p>
					<strong>
						Warenkorb, Kasse und Bestellbestätigung werden grundsätzlich
						nicht gemessen
					</strong>{" "}
					— auch dann nicht, wenn Sie eingewilligt haben. Auf diesen Seiten
					wird kein Google-Skript geladen. Von allen übrigen Seiten
					übermitteln wir nur die Adresse ohne Parameter, sodass Kennungen
					aus der Adresszeile nicht an Google gelangen.
				</p>
				<p>Mit Ihrer Einwilligung werden insbesondere verarbeitet:</p>
				<ul>
					<li>
						die aufgerufenen Seiten ohne Parameter, der Zeitpunkt und die
						Dauer des Aufrufs,
					</li>
					<li>die zuvor besuchte Seite (Referrer),</li>
					<li>
						Angaben zu Gerät, Browser und Betriebssystem sowie ein ungefährer
						Standort auf Land- und Stadtebene,
					</li>
					<li>
						Ihre IP-Adresse, die Google zur Ermittlung dieses ungefähren
						Standorts verwendet und dabei kürzt; eine Speicherung der
						vollständigen IP-Adresse findet in Google Analytics 4 nach Angaben
						von Google nicht statt,
					</li>
					<li>
						eine pseudonyme Kennung in den Cookies <code>_ga</code> und{" "}
						<code>_ga_&lt;ID&gt;</code>, über die wiederkehrende Aufrufe
						demselben Gerät zugeordnet werden. Diese Cookies haben eine
						Laufzeit von bis zu 24 Monaten.
					</li>
				</ul>
				<p>
					Die Aufbewahrungsdauer der Ereignis- und Nutzerdaten in unserer
					Google-Analytics-Property beträgt <strong>14 Monate</strong>. Nach
					Ablauf dieser Frist löscht Google die betroffenen Daten
					automatisch.
				</p>
				<p>
					Die so entstandenen Auswertungen rufen wir ausschließlich als
					zusammengefasste Berichte über die Berichtsschnittstelle von Google
					ab. Der dafür verwendete technische Zugang liegt auf unserem Server
					und ist nicht Bestandteil dieser Website; über ihn werden keine
					weiteren Daten von Ihnen erhoben.
				</p>
				<p>
					Mit Google haben wir einen Vertrag über die Auftragsverarbeitung
					nach Art. 28 DSGVO geschlossen. Google verarbeitet die im Rahmen
					von Google Analytics erhobenen Daten danach weisungsgebunden für
					uns.
				</p>
				<p>
					Sie können Ihre Einwilligung jederzeit mit Wirkung für die Zukunft
					widerrufen — über „Cookie-Einstellungen“ im Fußbereich jeder Seite.
					Beim Widerruf stoppen wir die weitere Erfassung und löschen die
					gesetzten Google-Analytics-Cookies. Die Rechtmäßigkeit der bis zum
					Widerruf erfolgten Verarbeitung bleibt unberührt.
				</p>
				<p>
					Einzelheiten zur Datenverarbeitung durch Google finden Sie in deren
					Datenschutzerklärung unter{" "}
					<a
						href="https://policies.google.com/privacy"
						rel="noopener noreferrer"
						target="_blank"
					>
						policies.google.com/privacy
					</a>
					.
				</p>
				<p>
					Darüber hinaus setzen wir keine Marketing- oder Werbedienste ein und
					binden keine externen Schriftarten, Karten oder sonstigen Inhalte
					Dritter ein.
				</p>
			</Fragment>
		) : (
			<Fragment>
				<p>
					Wir setzen derzeit <strong>keine</strong> Analyse-, Tracking- oder
					Marketing-Dienste ein und binden keine externen Schriftarten, Karten
					oder sonstigen Inhalte Dritter ein. Es werden ausschließlich die oben
					beschriebenen, technisch erforderlichen Daten verarbeitet.
				</p>
				<p>
					Sollte künftig ein Analysedienst eingesetzt werden, geschieht dies
					erst nach Ihrer ausdrücklichen Einwilligung und wird zuvor an dieser
					Stelle beschrieben.
				</p>
			</Fragment>
		)
	}

	<h2 id={S.rights.id}>{S.rights.heading}</h2>
	<p>Sie haben uns gegenüber das Recht auf:</p>
	<ul>
		<li>Auskunft über die zu Ihnen gespeicherten Daten (Art. 15 DSGVO),</li>
		<li>Berichtigung unrichtiger Daten (Art. 16 DSGVO),</li>
		<li>Löschung (Art. 17 DSGVO),</li>
		<li>Einschränkung der Verarbeitung (Art. 18 DSGVO),</li>
		<li>Datenübertragbarkeit (Art. 20 DSGVO),</li>
		<li>
			Widerspruch gegen Verarbeitungen auf Grundlage berechtigter Interessen
			(Art. 21 DSGVO).
		</li>
	</ul>
	{
		ANALYTICS_ENABLED && (
			<p>
				Eine erteilte Einwilligung können Sie jederzeit mit Wirkung für die
				Zukunft widerrufen (Art. 7 Abs. 3 DSGVO), ohne dass dies Nachteile für
