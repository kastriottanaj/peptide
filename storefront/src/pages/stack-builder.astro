---
import BaseLayout from "../layouts/BaseLayout.astro";
import StackBuilder from "../components/StackBuilder.astro";
import { listCategories, listProducts } from "../lib/catalog";
import { buildStackBuilderModel } from "../lib/stack-builder";
import { breadcrumbNode, canonicalUrl, ORGANIZATION_ID } from "../lib/site";
import { productPath } from "../lib/links";

const products = await listProducts();
const categories = await listCategories();
const model = buildStackBuilderModel(products, categories);
const path = "/stack-builder";

const jsonLd = [
	{
		"@type": "WebApplication",
		"@id": `${canonicalUrl(path)}#application`,
		name: "Peptid Stack-Builder",
		description:
			"Vergleichswerkzeug für Produkte, Packgrößen und Preise aus dem aktuellen Forschungskatalog.",
		url: canonicalUrl(path),
		applicationCategory: "UtilitiesApplication",
		operatingSystem: "Any",
		publisher: { "@id": ORGANIZATION_ID },
	},
	{
		"@type": "ItemList",
		"@id": `${canonicalUrl(path)}#products`,
		name: "Produkte im Stack-Builder",
		numberOfItems: products.length,
		itemListElement: products.map((product, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: product.title,
			url: canonicalUrl(productPath(product.handle)),
		})),
	},
	breadcrumbNode([
		["Start", "/"],
		["Stack-Builder", path],
	]),
];
---

<BaseLayout
	title="Peptid Stack-Builder für Labor und Forschung"
	description="Forschungsprodukte aus dem aktuellen Sortiment auswählen, Packgrößen und Preise vergleichen und als transparente Positionen zusammenstellen."
	rawTitle
	jsonLd={jsonLd}
>
	<nav class="crumbs" aria-label="Brotkrumen">
		<a href="/">Start</a>
		<span aria-hidden="true">/</span>
		<span>Stack-Builder</span>
	</nav>

	<header class="hero">
		<div>
			<span class="eyebrow">Labor-Tool</span>
			<h1>Peptid Stack-Builder für Laborbestellungen</h1>
			<p class="lead">
				Stelle Forschungsprodukte aus dem aktuellen Katalog zusammen und vergleiche
				Packgrößen, Verfügbarkeit, dokumentierte Produktangaben und Preise als
				getrennte Positionen.
			</p>
		</div>
		<aside class="hero__note">
			<strong>Vergleich statt Bundle</strong>
			<p>Presets sind neutrale Produktauswahlen. Sie sind keine eigenständigen Produkte oder Angebote.</p>
		</aside>
	</header>

	<ol class="steps" aria-label="So funktioniert der Stack-Builder">
		<li><span>1</span><div><strong>Auswahl treffen</strong><p>Preset oder einzelne Katalogprodukte wählen.</p></div></li>
		<li><span>2</span><div><strong>Packgrößen prüfen</strong><p>Varianten und verfügbare Preise vergleichen.</p></div></li>
		<li><span>3</span><div><strong>Übersicht lesen</strong><p>Positionen und Vergleichssumme transparent prüfen.</p></div></li>
	</ol>

	<StackBuilder model={model} />

	<section class="traceability" aria-labelledby="traceability-heading">
		<div>
			<span class="eyebrow">Produktdokumentation</span>
			<h2 id="traceability-heading">Angaben bleiben produktbezogen</h2>
			<p>
				Packgröße, Preis und vorhandener COA-Status werden je Katalogprodukt angezeigt.
				Die Zusammenstellung erzeugt kein neues Produkt und keine gemeinsame Zertifikatsangabe.
			</p>
		</div>
		<a class="traceability__link" href="/wissen/reinheit-und-coa/">Reinheit und COA einordnen →</a>
	</section>

	<style>
		.crumbs { display: flex; gap: 0.5rem; margin-bottom: 1rem; color: var(--c-muted); font-size: 0.82rem; }
		.crumbs a { color: var(--c-green-dark); font-weight: 650; text-decoration: none; }
		.hero { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(240px, 0.65fr); gap: 2rem; align-items: end; margin-bottom: 1.5rem; }
		.hero h1 { max-width: 18ch; margin: 0; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.05; }
		.lead { max-width: 68ch; margin: 1rem 0 0; color: var(--c-muted); font-size: 1.05rem; }
		.hero__note { padding: 1.1rem; border: 1px solid var(--c-border); border-radius: var(--radius); background: var(--c-surface); }
		.hero__note p { margin: 0.35rem 0 0; color: var(--c-muted); font-size: 0.85rem; }
		.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; padding: 0; margin: 0 0 3rem; list-style: none; }
		.steps li { display: flex; gap: 0.75rem; padding: 1rem; border: 1px solid var(--c-border); border-radius: var(--radius); }
		.steps li > span { display: grid; flex: 0 0 2rem; width: 2rem; height: 2rem; place-items: center; border-radius: 999px; color: var(--c-green-dark); background: var(--c-mint); font-weight: 800; }
		.steps p { margin: 0.2rem 0 0; color: var(--c-muted); font-size: 0.82rem; }
		.traceability { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-top: 3.5rem; padding: 1.5rem; border: 1px solid var(--c-border); border-radius: var(--radius); background: var(--c-surface); }
		.traceability h2 { margin: 0; }
		.traceability p { max-width: 70ch; margin: 0.5rem 0 0; color: var(--c-muted); }
		.traceability__link { flex: 0 0 auto; color: var(--c-green-dark); font-weight: 700; }
		@media (max-width: 760px) {
			.hero { grid-template-columns: 1fr; }
			.steps { grid-template-columns: 1fr; }
			.traceability { align-items: start; flex-direction: column; }
		}
	</style>
</BaseLayout>
