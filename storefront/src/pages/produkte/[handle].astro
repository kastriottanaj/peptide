---
import type { HttpTypes } from "@medusajs/types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AddToCart from "../../components/AddToCart.astro";
import {
	isProductAvailable,
	isVariantAvailable,
	listProductsInSourceOrder,
} from "../../lib/catalog";
import { absoluteUrl, breadcrumbNode, canonicalUrl, ORGANIZATION_ID } from "../../lib/site";
import { productImageAlt } from "../../lib/product-image-alt";

export async function getStaticPaths() {
	const products = await listProductsInSourceOrder({ limit: 1000 });

	return products.map((product) => ({
		params: { handle: product.handle },
		props: { product },
	}));
}

interface Props {
	product: HttpTypes.StoreProduct;
}

const { product } = Astro.props as Props;
const meta = (product.metadata ?? {}) as Record<string, unknown>;
const researchCode =
	typeof meta.research_code === "string" ? meta.research_code : null;
const purity = typeof meta.purity === "string" ? meta.purity : null;
const coaStatus =
	typeof meta.coa_status === "string" ? meta.coa_status : null;

const variants = product.variants ?? [];
const packSizes = variants.map((v) => v.title).filter(Boolean).join(" / ");

// --- SEO ---------------------------------------------------------------
const metaDescription =
	product.description?.trim() ||
	`${product.title} kaufen${purity ? ` – Reinheit ${purity}` : ""}${
		packSizes ? `, Packgrößen ${packSizes}` : ""
	}. Ausschließlich für Forschungs- und Laborzwecke.`;

// The AggregateOffer describes what a customer can actually buy, so a sold-out
// pack size must not set `lowPrice`: advertising a price nobody can order is a
// Merchant Center mismatch and, in a search result, a promise the shop breaks.
// Fall back to every variant only when nothing is orderable, so the range still
// reflects the product rather than collapsing to no offer at all.
const purchasableVariants = variants.filter(isVariantAvailable);
const pricedVariants = purchasableVariants.length ? purchasableVariants : variants;

const prices = pricedVariants
	.map((v) => v.calculated_price?.calculated_amount)
	.filter((a): a is number => typeof a === "number");

const currency = (
	variants.find((v) => v.calculated_price?.currency_code)?.calculated_price
		?.currency_code ?? "eur"
).toUpperCase();

const productNode: Record<string, unknown> = {
	"@type": "Product",
	"@id": `${canonicalUrl(`/produkte/${product.handle}`)}#product`,
	name: product.title,
	url: canonicalUrl(`/produkte/${product.handle}`),
	description: metaDescription,
	...(product.thumbnail ? { image: absoluteUrl(product.thumbnail) } : {}),
	...(researchCode ? { sku: researchCode } : {}),
	brand: { "@id": ORGANIZATION_ID },
	...(purity
		? {
				additionalProperty: [
					{ "@type": "PropertyValue", name: "Reinheit", value: purity },
				],
			}
		: {}),
	...(prices.length
		? {
				offers: {
					"@type": "AggregateOffer",
					priceCurrency: currency,
					lowPrice: Math.min(...prices),
					highPrice: Math.max(...prices),
					offerCount: prices.length,
					availability: isProductAvailable(product)
						? "https://schema.org/InStock"
						: "https://schema.org/OutOfStock",
					seller: { "@id": ORGANIZATION_ID },
				},
			}
		: {}),
};

const jsonLd = [
	productNode,
	breadcrumbNode([
		["Start", "/"],
		["Produkte", "/produkte"],
		[product.title, `/produkte/${product.handle}`],
	]),
];
---

<BaseLayout
	title={product.title}
	description={metaDescription}
	ogType="product"
	image={product.thumbnail
		? { url: absoluteUrl(product.thumbnail), alt: productImageAlt(product, "social") }
		: undefined}
	jsonLd={jsonLd}
>
	<a href="/produkte/" class="back">← Zurück zum Sortiment</a>

	<article class="detail">
		<div class="detail__media">
			{researchCode && <span class="badge badge--code">{researchCode}</span>}
			{purity && <span class="badge badge--purity">{purity}</span>}
			{
				product.thumbnail ? (
					/*
					 * The LCP element of this page whenever a thumbnail exists: it is
					 * the largest thing above the fold on both viewports (460×460 at
					 * 1366×900, 327×327 starting 230 px down at 390×844) and there is
					 * exactly one of it, so fetchpriority="high" is the justified case
					 * rather than a blanket setting. Never lazy.
					 *
					 * `.detail__media` is `aspect-ratio: 1 / 1`, so the frame is laid
					 * out before the image loads and nothing shifts.
					 */
					<img
						src={product.thumbnail}
						alt={productImageAlt(product, "detail")}
						loading="eager"
						fetchpriority="high"
						decoding="async"
						width="440"
						height="440"
					/>
				) : (
					<svg viewBox="0 0 80 100" aria-hidden="true">
						<rect x="30" y="6" width="20" height="10" rx="2" fill="#c9d3df" />
						<path d="M28 16h24v70a12 12 0 0 1-24 0V16Z" fill="#d9a441" />
						<rect x="34" y="24" width="12" height="26" rx="2" fill="#fff" opacity="0.35" />
					</svg>
				)
			}
		</div>

		<div class="detail__info">
			<span class="eyebrow">Forschungspeptid</span>
			<h1>{product.title}</h1>
			{product.description && <p class="detail__desc">{product.description}</p>}

			<dl class="specs">
				<div>
					<dt>Reinheit</dt>
					<dd>{purity ?? "—"}</dd>
				</div>
				<div>
					<dt>Packgrößen</dt>
					<dd>{packSizes || "—"}</dd>
				</div>
				<div>
					<dt>COA-Zertifikat</dt>
					<dd>{coaStatus ?? "—"}</dd>
				</div>
			</dl>

			<h2 class="variants__title">Packgröße wählen</h2>
			<AddToCart variants={variants} />

			<p class="disclaimer">
				Ausschließlich für Forschungs-, Analyse- und Laborzwecke. Keine
				medizinische Beratung, keine Anwendungshinweise.
			</p>
		</div>
	</article>

	<style>
		.back {
			display: inline-block;
			text-decoration: none;
			color: var(--c-green-dark);
			font-weight: 600;
			font-size: 0.9rem;
			margin-bottom: 1.25rem;
		}
		.detail {
			display: grid;
			grid-template-columns: minmax(0, 460px) 1fr;
			gap: 2.5rem;
			align-items: start;
		}
		.detail__media {
			position: relative;
			background: linear-gradient(180deg, var(--c-surface), var(--c-surface-2));
			border: 1px solid var(--c-border);
			border-radius: var(--radius);
			aspect-ratio: 1 / 1;
			display: grid;
			place-items: center;
			padding: 2rem;
		}
		.detail__media img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			mix-blend-mode: multiply;
		}
		.detail__media svg {
			width: 45%;
		}
		.badge {
			position: absolute;
			top: 1rem;
			font-size: 0.72rem;
			font-weight: 700;
			padding: 0.3rem 0.6rem;
			border-radius: 6px;
		}
		.badge--code {
			left: 1rem;
			background: var(--c-navy);
			color: var(--c-white);
		}
		.badge--purity {
			right: 1rem;
			background: var(--c-mint);
			color: var(--c-green-dark);
		}
		.detail__info h1 {
			font-size: clamp(1.6rem, 3vw, 2.2rem);
			margin: 0.25rem 0 0.75rem;
		}
		.detail__desc {
			color: var(--c-muted);
			margin: 0 0 1.5rem;
		}
		.specs {
			display: grid;
			gap: 0.5rem;
			margin: 0 0 1.75rem;
			padding: 1rem 1.2rem;
			background: var(--c-cream-soft);
			border: 1px solid var(--c-cream-border);
			border-radius: var(--radius);
		}
		.specs div {
			display: flex;
			justify-content: space-between;
			font-size: 0.9rem;
		}
		.specs dt {
			color: var(--c-muted);
		}
		.specs dd {
			margin: 0;
			font-weight: 600;
		}
		.variants__title {
			font-size: 1rem;
			margin: 0 0 0.6rem;
		}
		/* The `.variants` list and `.btn[disabled]` that used to sit here styled
		   markup this page no longer renders — the pack sizes moved into
		   `AddToCart.astro`, which brings its own scoped styles. Astro scopes
		   these rules to this component, so they could never have matched the
		   markup in that one. */
		.disclaimer {
			margin: 1.25rem 0 0;
			font-size: 0.78rem;
			color: var(--c-muted);
		}

		@media (max-width: 820px) {
			.detail {
				grid-template-columns: 1fr;
			}
		}
	</style>
</BaseLayout>
