---
import BaseLayout from "../layouts/BaseLayout.astro";
import { listCategories } from "../lib/catalog";
import { categoryPath } from "../lib/links";

// AGENTS.md: unknown slugs return noindex, nofollow rather than a soft 200.
const categories = await listCategories();
---

<BaseLayout
	title="Seite nicht gefunden"
	description="Die aufgerufene Seite existiert nicht."
	noindex
>
	<div class="nf">
		<span class="eyebrow">Fehler 404</span>
		<h1>Diese Seite gibt es nicht</h1>
		<p class="lead">
			Der Link ist möglicherweise veraltet oder enthält einen Tippfehler.
			Vielleicht hilft einer dieser Wege weiter:
		</p>

		<div class="nf__actions">
			<a class="btn btn--green" href="/produkte/">Zum Sortiment</a>
			<a class="btn nf__ghost" href="/wissen/">Wissen &amp; Grundlagen</a>
		</div>

		<form class="nf__search" action="/produkte/" method="get" role="search">
			<label>
				<span class="visually-hidden">Sortiment durchsuchen</span>
				<input
					type="search"
					name="q"
					placeholder="Nach Peptid oder Research-Code suchen…"
					autocomplete="off"
				/>
			</label>
			<button class="btn btn--green btn--sm" type="submit">Suchen</button>
		</form>

		{
			categories.length > 0 && (
				<section class="nf__cats">
					<h2>Kategorien</h2>
					<nav>
						{categories.map((category) => (
							<a href={categoryPath(category.handle)}>{category.name}</a>
						))}
					</nav>
				</section>
			)
		}

		<p class="nf__support">
			Sie suchen eine aufgegebene Bestellung?
			<a href="/bestellung/suchen/">Bestellung suchen</a> · Weiterhin Fragen?
			<a href="/contact/">Support kontaktieren</a>
		</p>
	</div>

	<style>
		.nf {
			max-width: 60ch;
			padding-block: 1rem 3rem;
		}
		.lead {
			color: var(--c-muted);
			margin: 0.25rem 0 1.75rem;
		}
		.nf__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-bottom: 2rem;
		}
		.nf__ghost {
			background: var(--c-white);
			color: var(--c-navy);
			box-shadow: inset 0 0 0 1.5px var(--c-border);
		}
		.nf__ghost:hover {
			box-shadow: inset 0 0 0 1.5px var(--c-green);
			color: var(--c-green-dark);
		}
		.nf__search {
			display: flex;
			gap: 0.6rem;
			margin-bottom: 2.25rem;
		}
		.nf__search label {
			flex: 1;
		}
		.nf__search input {
			width: 100%;
			padding: 0.6rem 0.9rem;
			border: 1px solid var(--c-border);
			border-radius: 999px;
			font-family: inherit;
			font-size: 0.9rem;
			color: var(--c-ink);
			background: var(--c-field);
		}
		.nf__search input:focus-visible {
			outline: 2px solid var(--c-green);
			outline-offset: 1px;
		}
		.nf__cats h2 {
			font-size: 0.95rem;
			margin-bottom: 0.75rem;
		}
		.nf__cats nav {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}
		.nf__cats a {
			display: inline-block;
			padding: 0.35rem 0.85rem;
			border: 1px solid var(--c-border);
			border-radius: 999px;
			font-size: 0.85rem;
			font-weight: 600;
			text-decoration: none;
			color: var(--c-navy);
		}
		.nf__cats a:hover {
			border-color: var(--c-green);
			color: var(--c-green-dark);
		}
		.nf__support {
			margin-top: 2.5rem;
			padding-top: 1.25rem;
			border-top: 1px solid var(--c-border);
			font-size: 0.88rem;
			color: var(--c-muted);
		}
		.nf__support a {
			color: var(--c-green-dark);
			font-weight: 600;
		}
		/* `.visually-hidden` is BaseLayout's, from its global block — this page
		   renders inside that layout, so a scoped copy only duplicated it. */
	</style>
</BaseLayout>
