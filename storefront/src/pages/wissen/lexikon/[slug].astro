---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
	canonicalUrl,
	breadcrumbNode,
	ORGANIZATION_ID,
} from "../../../lib/site";
import { lexikonPath } from "../../../lib/links";

export async function getStaticPaths() {
	const terms = await getCollection("lexikon", ({ data }) => !data.draft);
	return terms.map((term) => ({
		params: { slug: term.id },
		props: { term },
	}));
}

interface Props {
	term: CollectionEntry<"lexikon">;
}

const { term } = Astro.props;
const { Content } = await render(term);
const data = term.data;
const url = canonicalUrl(`/wissen/lexikon/${term.id}`);

const allTerms = await getCollection("lexikon", ({ data }) => !data.draft);
const related = data.relatedTerms
	.map((slug) => allTerms.find((t) => t.id === slug))
	.filter((t): t is CollectionEntry<"lexikon"> => Boolean(t));

const jsonLd = [
	{
		"@type": "DefinedTerm",
		"@id": `${url}#term`,
		name: data.term,
		description: data.summary,
		url,
		inLanguage: "de-DE",
		...(data.aliases.length ? { alternateName: data.aliases } : {}),
		inDefinedTermSet: {
			"@type": "DefinedTermSet",
			"@id": `${canonicalUrl("/wissen/lexikon")}#termset`,
			name: "Peptid-Lexikon",
			url: canonicalUrl("/wissen/lexikon"),
			publisher: { "@id": ORGANIZATION_ID },
		},
	},
	breadcrumbNode([
		["Start", "/"],
		["Wissen", "/wissen"],
		["Lexikon", "/wissen/lexikon"],
		[data.term, `/wissen/lexikon/${term.id}`],
	]),
];
---

<BaseLayout
	title={`${data.term} – Definition`}
	description={data.metaDescription}
	ogType="article"
	jsonLd={jsonLd}
>
	<article class="term">
		<nav class="crumbs" aria-label="Brotkrumen">
			<a href="/wissen/">Wissen</a>
			<span aria-hidden="true">/</span>
			<a href="/wissen/lexikon/">Lexikon</a>
		</nav>

		<h1>{data.term}</h1>
		{
			data.aliases.length > 0 && (
				<p class="aliases">Auch: {data.aliases.join(", ")}</p>
			)
		}
		<p class="summary">{data.summary}</p>
		{data.researchArea && <p class="area">Bereich: {data.researchArea}</p>}

		<div class="prose">
			<Content />
		</div>

		{
			related.length > 0 && (
				<aside class="related">
					<h2>Verwandte Begriffe</h2>
					<ul>
						{related.map((entry) => (
							<li>
								<a href={lexikonPath(entry.id)}>{entry.data.term}</a>
							</li>
						))}
					</ul>
				</aside>
			)
		}

		<a class="back" href="/wissen/lexikon/">← Alle Begriffe</a>
	</article>

	<style>
		.term {
			max-width: 68ch;
		}
		.crumbs {
			display: flex;
			gap: 0.5rem;
			font-size: 0.82rem;
			color: var(--c-muted);
			margin-bottom: 0.75rem;
		}
		.crumbs a {
			color: var(--c-green-dark);
			text-decoration: none;
			font-weight: 600;
		}
		.aliases {
			margin: -0.25rem 0 0.75rem;
			font-size: 0.85rem;
			color: var(--c-muted);
		}
		.summary {
			font-size: 1.05rem;
			font-weight: 600;
			padding: 0.9rem 1.1rem;
			background: var(--c-mint);
			border-radius: var(--radius);
			margin: 0 0 0.75rem;
		}
		.area {
			margin: 0 0 1.75rem;
			font-size: 0.82rem;
			color: var(--c-muted);
		}
		.prose :global(p),
		.prose :global(li) {
			font-size: 0.97rem;
		}
		.prose :global(ul) {
			padding-left: 1.25rem;
		}
		.prose :global(li) {
			margin-bottom: 0.4rem;
		}
		.prose :global(a) {
			color: var(--c-green-dark);
			font-weight: 600;
		}
		.related {
			margin-top: 2.25rem;
			padding: 1rem 1.2rem;
			border: 1px solid var(--c-border);
			border-radius: var(--radius);
		}
		.related h2 {
			font-size: 0.95rem;
			margin: 0 0 0.6rem;
		}
		.related ul {
			list-style: none;
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			margin: 0;
			padding: 0;
		}
		.related a {
			display: inline-block;
			padding: 0.3rem 0.75rem;
			border: 1px solid var(--c-border);
			border-radius: 999px;
			font-size: 0.85rem;
			font-weight: 600;
			text-decoration: none;
			color: var(--c-navy);
		}
		.back {
			display: inline-block;
			margin-top: 2rem;
			font-size: 0.9rem;
			font-weight: 600;
			color: var(--c-green-dark);
			text-decoration: none;
		}
	</style>
</BaseLayout>
