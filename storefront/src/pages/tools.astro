---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbNode, canonicalUrl, ORGANIZATION_ID } from "../lib/site";

const title = "Tools für Forschungspeptide: Rechner, COA & Vergleich";
const description =
	"Peptid-Rechner, COA-Zertifikate, Produktvergleich und Lagerungs-Guide für Forschungszwecke zentral nutzen. Tools jetzt entdecken!";

const tools = [
	{
		title: "COA-Zertifikat",
		text: "Nachschlagen, ob zu Produkt und Packgröße Analysedokumentation verknüpft ist.",
		href: "/coa-pruefen/",
		paths: ["M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z", "M14 2v6h6", "M8 13h8", "M8 17h8", "M8 9h2"],
	},
	{
		title: "Peptid-Rechner",
		text: "Konzentration, Rekonstitutionsvolumen und U-100-Units berechnen.",
		href: "/peptid-rechner/",
		paths: ["M4 2h16v20H4z", "M8 6h8", "M8 11h2", "M14 11h2", "M8 15h2", "M14 15h2", "M8 19h2", "M14 19h2"],
	},
	{
		title: "Stack-Builder",
		text: "Mehrere Forschungsprodukte mit Varianten und Zertifikatsbezug bündeln.",
		href: "/stack-builder/",
		paths: ["m12 2 9 5-9 5-9-5 9-5Z", "m3 12 9 5 9-5", "m3 17 9 5 9-5"],
	},
	{
		title: "Vergleichstool",
		text: "Peptide nach Reinheit, Packgröße, Preis und Forschungsbereich vergleichen.",
		href: "/produkte/",
		paths: ["M8 3H5a2 2 0 0 0-2 2v3", "M16 21h3a2 2 0 0 0 2-2v-3", "M21 8V5a2 2 0 0 0-2-2h-3", "M3 16v3a2 2 0 0 0 2 2h3", "m8 8 4-4 4 4", "m8 16 4 4 4-4", "M12 4v16"],
	},
	{
		title: "Produktanfrage",
		text: "Sondermengen, wiederkehrende Laborbestellungen und Zertifikatsfragen senden.",
		href: "/support/anfrage/",
		paths: ["m12 2 4 2.3v4.6L12 11.2 8 8.9V4.3L12 2Z", "m8 8.9-4 2.3v4.6L8 18l4-2.3v-4.5", "m16 8.9 4 2.3v4.6L16 18l-4-2.3", "m8 18 4 2.3 4-2.3"],
	},
	{
		title: "Lagerungs-Guide",
		text: "Produktbezogene Lagerhinweise und Kennzeichnungsdaten nachschlagen.",
		href: "/wissen/lagerung-lyophilisierter-peptide/",
		paths: ["M14 14.8V5a2 2 0 0 0-4 0v9.8a4 4 0 1 0 4 0Z", "M12 12v6", "M4 5v14", "m2 7-2 2-2-2", "m2 5-2 2-2-2", "m2 9-2 2-2-2"],
	},
	{
		title: "Support anfragen",
		text: "Fragen zu Varianten, Zertifikatsstatus und Lieferkommunikation.",
		href: "/support/anfrage/",
		paths: ["M4.9 4.9a10 10 0 0 1 14.2 0", "M19.1 19.1a10 10 0 0 1-14.2 0", "M4.9 19.1a10 10 0 0 1 0-14.2", "M19.1 4.9a10 10 0 0 1 0 14.2", "M8.5 8.5a5 5 0 0 1 7 7", "M15.5 8.5a5 5 0 0 1-7 7"],
	},
];

const jsonLd = [
	{
		"@type": "CollectionPage",
		"@id": `${canonicalUrl("/tools")}#page`,
		name: title,
		description,
		url: canonicalUrl("/tools"),
		inLanguage: "de-DE",
		publisher: { "@id": ORGANIZATION_ID },
		mainEntity: {
			"@type": "ItemList",
			itemListElement: tools.map((tool, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: tool.title,
				url: canonicalUrl(tool.href),
			})),
		},
	},
	breadcrumbNode([
		["Start", "/"],
		["Tools", "/tools"],
	]),
];
---

<BaseLayout title={title} description={description} wide jsonLd={jsonLd}>
	<section class="tools-hero">
		<div class="tools-shell">
			<header class="intro">
				<span class="eyebrow">Produktdaten</span>
				<h1>Rechner, COA-Zertifikate und Produktvergleich</h1>
				<p>
					Prüfe Produktdaten, berechne Laborparameter und kläre
					Zertifikatsfragen, bevor du Forschungsprodukte bestellst.
				</p>
			</header>

			<div class="tools-grid" aria-label="Tools und Serviceangebote">
				{
					tools.map((tool) => (
						<a class="tool-card" href={tool.href}>
							<span class="tool-card__icon">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									{tool.paths.map((path) => <path d={path} />)}
								</svg>
							</span>
							<span class="tool-card__content">
								<span class="tool-card__title">{tool.title}</span>
								<span class="tool-card__text">{tool.text}</span>
							</span>
						</a>
					))
				}
			</div>

			<aside class="calculator" aria-labelledby="calculator-title">
				<svg class="calculator__icon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M4 19V9" />
					<path d="M9 19V5" />
					<path d="M14 19v-7" />
					<path d="M19 19v-3" />
					<path d="M3 21h18" />
				</svg>
				<h2 id="calculator-title">Peptid-Rechner</h2>
				<p>
					Berechne Konzentration, Lösungsvolumen und U-100-Units für
					Forschungsansätze. Keine medizinischen Dosierungshinweise.
				</p>
				<a href="/peptid-rechner/" class="calculator__button">Rechner öffnen</a>
			</aside>
		</div>
	</section>

	<style>
		.tools-hero {
			background: var(--c-blue-tint);
			padding: 3rem 1.5rem 3.5rem;
			max-width: 100vw;
			overflow: clip;
		}

		.tools-shell {
			max-width: var(--container);
			margin-inline: auto;
		}

		.intro {
			max-width: 48rem;
			margin-bottom: 2rem;
		}

		.intro .eyebrow {
			margin-bottom: 0.75rem;
			text-transform: none;
			letter-spacing: 0;
		}

		.intro h1 {
			max-width: 24ch;
			font-size: clamp(2rem, 4vw, 2.75rem);
			margin-bottom: 0.65rem;
			overflow-wrap: anywhere;
		}

		.intro p {
			max-width: 62ch;
			margin: 0;
			color: var(--c-muted);
			font-size: 1.05rem;
			line-height: 1.7;
		}

		.tools-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.1rem;
		}

		.tool-card {
			display: flex;
			flex-direction: column;
			min-height: 12.25rem;
			padding: 1.5rem;
			border: 1px solid var(--c-white);
			border-radius: calc(var(--radius) + 8px);
			background: var(--c-white);
			color: var(--c-ink);
			text-decoration: none;
			min-width: 0;
			box-shadow: 0 1rem 2.8rem var(--c-border);
			transition: transform 160ms ease, border-color 160ms ease,
				box-shadow 160ms ease;
		}

		.tool-card:hover {
			transform: translateY(-3px);
			border-color: var(--c-green);
			box-shadow: 0 1.35rem 3.2rem var(--c-border);
		}

		.tool-card:focus-visible,
		.calculator__button:focus-visible {
			outline: 3px solid var(--c-green);
			outline-offset: 3px;
		}

		.tool-card__icon {
			display: grid;
			place-items: center;
			width: 3rem;
			height: 3rem;
			border-radius: 50%;
			background: var(--c-mint);
			color: var(--c-green);
		}

		.tool-card__icon svg {
			width: 1.5rem;
			height: 1.5rem;
			fill: none;
			stroke: currentColor;
			stroke-width: 1.9;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		.tool-card__content {
			display: grid;
			gap: 0.5rem;
			margin-top: 1.15rem;
		}

		.tool-card__title {
			font-size: 1.12rem;
			font-weight: 750;
			line-height: 1.25;
			letter-spacing: -0.01em;
		}

		.tool-card__text {
			color: var(--c-muted);
			line-height: 1.65;
		}

		.calculator {
			margin-top: 2rem;
			padding: 2rem;
			border-radius: calc(var(--radius) + 10px);
			background: var(--c-navy);
			color: var(--c-white);
			box-shadow: 0 1.5rem 3.5rem var(--c-border);
		}

		.calculator__icon {
			width: 1.9rem;
			height: 1.9rem;
			fill: none;
			stroke: var(--c-gold);
			stroke-width: 1.9;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		.calculator h2 {
			margin-top: 1rem;
			font-size: 1.45rem;
		}

		.calculator p {
			max-width: 46rem;
			margin: 0;
			color: var(--c-on-navy-200);
			line-height: 1.65;
		}

		.calculator__button {
			display: inline-flex;
			margin-top: 1.25rem;
			padding: 0.65rem 1rem;
			border-radius: 999px;
			background: var(--c-white);
			color: var(--c-navy);
			font-size: 0.88rem;
			font-weight: 700;
			text-decoration: none;
		}

		@media (max-width: 880px) {
			.tools-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (max-width: 560px) {
			.tools-hero {
				padding: 2rem 1rem 2.5rem;
			}

			.tools-grid {
				grid-template-columns: minmax(0, 1fr);
			}

			.tool-card {
				min-height: 0;
				padding: 1.25rem;
			}

			.calculator {
				padding: 1.5rem;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.tool-card {
				transition: none;
			}
		}
	</style>
</BaseLayout>
