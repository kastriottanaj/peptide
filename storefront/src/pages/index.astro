---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/homepage-scientific-hero.png";
import { ORGANIZATION_ID, SITE_NAME, SITE_URL } from "../lib/site";
import { categoryPath, productPath } from "../lib/links";
import { productImageAlt } from "../lib/product-image-alt";
import {
	listCategories,
	listProductsInSourceOrder,
} from "../lib/catalog";

const allProducts = await listProductsInSourceOrder({ limit: 20 });

// Source order is the catalog's only current editorial signal. Prefer a product
// carrying the peptide-specific research code, then fall back to the first real
// catalog record. No popularity or "top product" claim is inferred here.
const spotlight =
	allProducts.find(
		(product) =>
			typeof (product.metadata as Record<string, unknown> | null)
				?.research_code === "string",
	) ?? allProducts[0];

const spotlightMeta = (spotlight?.metadata ?? {}) as Record<string, unknown>;
const spotlightCode =
	typeof spotlightMeta.research_code === "string"
		? spotlightMeta.research_code
		: null;
const spotlightSizes = (spotlight?.variants ?? [])
	.map((variant) => variant.title?.trim())
	.filter((title): title is string => Boolean(title));

function priceOf(product: (typeof allProducts)[number] | undefined) {
	if (!product) return null;
	const priced = (product.variants ?? [])
		.map((variant) => ({
			amount: variant.calculated_price?.calculated_amount,
			currency: variant.calculated_price?.currency_code ?? "eur",
		}))
		.filter(
			(value): value is { amount: number; currency: string } =>
				typeof value.amount === "number",
		);
	if (!priced.length) return null;
	const lowest = priced.reduce((a, b) => (a.amount <= b.amount ? a : b));
	return new Intl.NumberFormat("de-DE", {
		style: "currency",
		currency: lowest.currency.toUpperCase(),
	}).format(lowest.amount);
}

const spotlightPrice = priceOf(spotlight);

const qualityCards = [
	{
		title: "Qualitäts- und Analyseinformationen",
		body: "Einordnung der Angaben zu Reinheit, Analytik und produktbezogener Dokumentation.",
		href: "/qualitaet-analyse/",
		icon: "flask",
	},
	{
		title: "Zertifikate und Dokumentation",
		body: "Hinweise dazu, wie vorhandene Zertifikate und Analyseangaben dargestellt werden.",
		href: "/wissen/reinheit-und-coa/",
		icon: "document",
	},
	{
		title: "Versandinformationen",
		body: "Informationen zu Versand und Lieferzeit werden vor Aktivierung des Bestellvorgangs veröffentlicht.",
		href: "/versand-zahlung/",
		icon: "package",
	},
];

const transparencyCards = [
	{
		title: "Analyseangaben einordnen",
		body: "Was Produktangaben aussagen – und welche Nachweise dafür erforderlich sind.",
		href: "/qualitaet-analyse/",
	},
	{
		title: "Nur für Forschungszwecke",
		body: "Klare Abgrenzung zu medizinischer Anwendung und menschlichem Gebrauch.",
		href: "/forschungszwecke/",
	},
	{
		title: "Redaktionelle Standards",
		body: "Wie Fachinhalte ausgewählt, belegt, aktualisiert und korrigiert werden.",
		href: "/redaktionsrichtlinien/",
	},
	{
		title: "Häufige Fragen",
		body: "Antworten zu Produktinformationen, Bestellstatus und Supportwegen.",
		href: "/faq/",
	},
];

const CATEGORY_FALLBACKS: Record<
	string,
	{ title: string; body: string; icon: string }
> = {
	"neuropeptid-forschung": {
		title: "Neuropeptid-Forschung",
		body: "Forschungsbezogene Projekte zu neuronalen Signalwegen und Modellforschung.",
		icon: "network",
	},
	regenerationsforschung: {
		title: "Regenerationsforschung",
		body: "Peptide und Fragmente für Zellkommunikations-, Gewebe- und Signalwegmodelle.",
		icon: "leaf",
	},
	"signal-fragmentpeptide": {
		title: "Signal- & Fragmentpeptide",
		body: "Fragment- und Signalpeptide mit produktbezogenen Angaben für Laborprojekte.",
		icon: "molecule",
	},
	"stoffwechsel-forschung": {
		title: "Stoffwechsel-Forschung",
		body: "Forschungskategorien für analytische Laborprojekte zu metabolischen Mechanismen.",
		icon: "drop",
	},
};

const categoryRecords = await listCategories();
const categoryByHandle = new Map(
	categoryRecords.map((category) => [category.handle, category]),
);
const categories = Object.entries(CATEGORY_FALLBACKS).map(
	([handle, fallback]) => {
		const category = categoryByHandle.get(handle);
		return {
			handle,
			title: category?.name?.trim() || fallback.title,
			body: category?.description?.trim() || fallback.body,
			icon: fallback.icon,
		};
	},
);

const faqs = [
	{
		q: "Wofür sind die Produkte vorgesehen?",
		a: "Alle Produkte sind ausschließlich für Forschungs-, Analyse- und Laborzwecke bestimmt. Sie sind nicht für den menschlichen Gebrauch vorgesehen.",
	},
	{
		q: "Wo finde ich Analyse- und Zertifikatsinformationen?",
		a: "Produktbezogene Angaben stehen auf der jeweiligen Detailseite. Die Seite Qualität und Analyse erklärt zusätzlich, wie diese Informationen einzuordnen sind.",
	},
	{
		q: "Kann ich derzeit eine Bestellung abschließen?",
		a: "Der Bestellvorgang ist derzeit nicht verfügbar. Sortiment, Packgrößen und Preise können weiterhin eingesehen werden.",
	},
	{
		q: "Wie erreiche ich den Support?",
		a: "Die Support-Anfrage führt zu den passenden Kontaktwegen für Produktdaten, bestehende Bestellungen und weitere Anliegen.",
	},
];

const homeJsonLd = [
	{
		"@type": "WebSite",
		"@id": `${SITE_URL}/#website`,
		url: SITE_URL,
		name: SITE_NAME,
		publisher: { "@id": ORGANIZATION_ID },
		inLanguage: "de-DE",
	},
	{
		"@type": "FAQPage",
		"@id": `${SITE_URL}/#faq`,
		mainEntity: faqs.map((faq) => ({
			"@type": "Question",
			name: faq.q,
			acceptedAnswer: { "@type": "Answer", text: faq.a },
		})),
	},
];

const iconPaths: Record<string, string[]> = {
	flask: ["M9 3h6", "M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3", "M8 15h8"],
	document: ["M6 3h9l3 3v15H6z", "M15 3v4h4", "M9 12h6", "M9 16h6"],
	package: ["m4 8 8-4 8 4-8 4z", "M4 8v9l8 4 8-4V8", "M12 12v9"],
	network: ["M12 5v14", "M5 9h14", "M5 15h14", "M5 7a2 2 0 1 0 0 4", "M19 7a2 2 0 1 1 0 4", "M5 13a2 2 0 1 0 0 4", "M19 13a2 2 0 1 1 0 4"],
	leaf: ["M20 4C11 4 5 8 5 15c0 3 2 5 5 5 7 0 10-8 10-16Z", "M8 17c3-4 6-6 10-9"],
	molecule: ["M6 17 10 9l7-3", "M10 9l7 8", "M6 17h11", "M6 20a3 3 0 1 0 0-6 3 3 0 0 0 0 6", "M10 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6", "M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6", "M18 20a3 3 0 1 0 0-6 3 3 0 0 0 0 6"],
	drop: ["M12 3s6 7 6 12a6 6 0 0 1-12 0c0-5 6-12 6-12Z", "M9 16c.5 1 1.4 1.5 2.5 1.5"],
};
---

<BaseLayout
	title="Peptide kaufen in Deutschland für Forschung & Analyse"
	description="Forschungspeptide für Labor und Analyse mit klaren Produktdaten, Packgrößen und COA-Status. Jetzt Produkte vergleichen!"
	rawTitle
	wide
	jsonLd={homeJsonLd}
>
	<section class="hero" aria-labelledby="home-heading">
		<Picture
			class="hero__image"
			src={heroImage}
			formats={["avif", "webp"]}
			widths={[640, 960, 1280, 1672]}
			sizes="100vw"
			alt=""
			aria-hidden="true"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="hero__veil" aria-hidden="true"></div>
		<div class:list={["hero__inner", "container", !spotlight && "hero__inner--solo"]}>
			<div class="hero__copy">
				<span class="hero__eyebrow">Forschungspeptide in Deutschland</span>
				<h1 id="home-heading">
					Forschungspeptide in Deutschland kaufen
				</h1>
				<p class="hero__lead">
					Produkte und Informationen für wissenschaftliche Forschung,
					Laboranalyse und dokumentierte Modellprojekte.
				</p>
				<div class="hero__actions">
					<a href="/produkte/" class="btn btn--green">Peptide entdecken <span aria-hidden="true">→</span></a>
					<a href="/qualitaet-analyse/" class="btn btn--ghost">Qualität und Analyse</a>
				</div>
				<ul class="hero__trust" aria-label="Hinweise zum Sortiment">
					<li>Nur für Forschungszwecke</li>
					<li>Produktbezogene Angaben</li>
					<li>Support zu Produktdaten</li>
				</ul>
			</div>

			{
				spotlight && (
					<article class="spotlight" aria-labelledby="spotlight-title">
						<div class="spotlight__label">Aus dem Sortiment</div>
						<div class="spotlight__layout">
							<div class="spotlight__content">
								{spotlightCode && <p class="spotlight__code">{spotlightCode}</p>}
								<h2 id="spotlight-title">{spotlight.title}</h2>
								{spotlightPrice && <p class="spotlight__price">ab {spotlightPrice}</p>}
								<a href={productPath(spotlight.handle)} class="btn btn--green btn--sm">
									Produkt ansehen <span aria-hidden="true">→</span>
								</a>
							</div>
							<div class="spotlight__media">
								{spotlight.thumbnail ? (
									<img
										src={spotlight.thumbnail}
										alt={productImageAlt(spotlight, "card")}
										loading="lazy"
										decoding="async"
										width="240"
										height="240"
									/>
								) : (
									<svg viewBox="0 0 80 100" aria-hidden="true">
										<rect x="30" y="6" width="20" height="10" rx="2" fill="#c9d3df" />
										<path d="M28 16h24v70a12 12 0 0 1-24 0V16Z" fill="#d9a441" />
										<rect x="34" y="24" width="12" height="26" rx="2" fill="#fff" opacity="0.35" />
									</svg>
								)}
							</div>
						</div>
						{spotlightSizes.length > 0 && (
							<div class="spotlight__sizes">
								<span>Packgrößen</span>
								<ul>
									{spotlightSizes.map((size) => <li>{size}</li>)}
								</ul>
							</div>
						)}
					</article>
				)
			}
		</div>
	</section>

	<nav class="trust-strip" aria-label="Qualität, Forschung und Support">
		<div class="container trust-strip__grid">
			<a href="/qualitaet-analyse/">
				<span class="trust-strip__icon" aria-hidden="true">✓</span>
				<span><strong>Analyseinformationen</strong><small>Angaben einordnen</small></span>
			</a>
			<a href="/forschungszwecke/">
				<span class="trust-strip__icon" aria-hidden="true">i</span>
				<span><strong>Forschungszwecke</strong><small>Verwendung klar abgegrenzt</small></span>
			</a>
			<a href="/versand-zahlung/">
				<span class="trust-strip__icon" aria-hidden="true">↗</span>
				<span><strong>Versand &amp; Zahlung</strong><small>Aktuellen Stand prüfen</small></span>
			</a>
			<a href="/support/anfrage/">
				<span class="trust-strip__icon" aria-hidden="true">?</span>
				<span><strong>Support-Anfrage</strong><small>Passenden Kontaktweg finden</small></span>
			</a>
		</div>
	</nav>

	<section class="section section--tight container" aria-labelledby="quality-title">
		<div class="section__intro">
			<span class="eyebrow">Orientierung</span>
			<h2 id="quality-title">Informationen vor der Produktauswahl prüfen</h2>
			<p>Direkte Wege zu Analyse, Dokumentation und dem aktuellen operativen Stand.</p>
		</div>
		<div class="quality-grid">
			{
				qualityCards.map((card) => (
					<a class="quality-card" href={card.href}>
						<span class="line-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								{iconPaths[card.icon].map((path) => (
									<path d={path} />
								))}
							</svg>
						</span>
						<span>
							<h3>{card.title}</h3>
							<p>{card.body}</p>
							<strong>Informationen ansehen <span aria-hidden="true">→</span></strong>
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="transparency" aria-labelledby="transparency-title">
		<div class="container transparency__inner">
			<div class="transparency__head">
				<span class="eyebrow eyebrow--dark">Nachvollziehbar informiert</span>
				<h2 id="transparency-title">Qualität und Transparenz im Überblick</h2>
				<p>Fakten, Grenzen und redaktionelle Standards anstelle pauschaler Versprechen.</p>
			</div>
			<div class="transparency__grid">
				{
					transparencyCards.map((card, index) => (
						<a href={card.href} class="transparency-card">
							<span class="transparency-card__number" aria-hidden="true">
								{String(index + 1).padStart(2, "0")}
							</span>
							<h3>{card.title}</h3>
							<p>{card.body}</p>
							<strong>Mehr erfahren <span aria-hidden="true">→</span></strong>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section container" aria-labelledby="categories-title">
		<div class="section__head">
			<div class="section__intro">
				<span class="eyebrow">Forschungsbereiche</span>
				<h2 id="categories-title">Beliebte Forschungsbereiche</h2>
				<p>Das Sortiment nach bestehenden Forschungskategorien erkunden.</p>
			</div>
			<a href="/produkte/" class="section__link">Alle Produkte ansehen <span aria-hidden="true">→</span></a>
		</div>
		<div class="category-grid">
			{
				categories.map((category) => (
					<article class="category-card">
						<span class="line-icon line-icon--large" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								{iconPaths[category.icon].map((path) => (
									<path d={path} />
								))}
							</svg>
						</span>
						<h3>{category.title}</h3>
						<p>{category.body}</p>
						<a href={categoryPath(category.handle)}>
							Produkte ansehen <span class="visually-hidden">in {category.title}</span>
							<span aria-hidden="true">→</span>
						</a>
					</article>
				))
			}
		</div>
	</section>

	<section class="section section--faq container" aria-labelledby="faq-title">
		<div class="section__intro">
			<span class="eyebrow">Kurz erklärt</span>
			<h2 id="faq-title">Häufige Fragen</h2>
		</div>
		<div class="faq-grid">
			{
				faqs.map((faq) => (
					<details>
						<summary>{faq.q}</summary>
						<p>{faq.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<section class="container closing" aria-labelledby="closing-title">
		<div>
			<h2 id="closing-title">Forschungsprodukte und Informationen entdecken</h2>
			<p>Sortiment vergleichen oder den passenden Supportweg für Ihre Frage finden.</p>
		</div>
		<div class="closing__actions">
			<a href="/produkte/" class="btn btn--green">Produkte ansehen <span aria-hidden="true">→</span></a>
			<a href="/support/anfrage/" class="btn closing__secondary">Support kontaktieren</a>
		</div>
	</section>

	<style>
		.hero {
			position: relative;
			isolation: isolate;
			overflow: hidden;
			background: var(--c-navy-deep);
			color: var(--c-white);
		}
		.hero__image,
		.hero__veil {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
		}
		.hero__image {
			z-index: -3;
			object-fit: cover;
			object-position: center;
		}
		.hero__veil {
			z-index: -2;
			background: linear-gradient(90deg, var(--c-navy-deep) 4%, color-mix(in srgb, var(--c-navy-deep) 88%, transparent) 45%, color-mix(in srgb, var(--c-navy-deep) 62%, transparent));
		}
		.hero__inner {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(330px, 0.85fr);
			align-items: center;
			gap: clamp(2rem, 5vw, 4.5rem);
			min-height: 520px;
			padding-block: clamp(3.5rem, 7vw, 5.75rem);
		}
		.hero__inner--solo {
			grid-template-columns: minmax(0, 680px);
		}
		.hero__copy {
			max-width: 660px;
		}
		.hero__eyebrow {
			display: inline-flex;
			padding: 0.35rem 0.7rem;
			border-radius: 999px;
			background: color-mix(in srgb, var(--c-white) 10%, transparent);
			color: var(--c-on-navy-100);
			font-size: 0.7rem;
			font-weight: 800;
			letter-spacing: 0.07em;
			text-transform: uppercase;
		}
		.hero h1 {
			max-width: 13ch;
			margin: 1rem 0 1rem;
			font-size: clamp(2.45rem, 4.6vw, 4.15rem);
			font-weight: 850;
			letter-spacing: -0.045em;
		}
		.hero h1::after {
			content: ".";
			color: var(--c-green);
		}
		.hero__lead {
			max-width: 54ch;
			margin: 0;
			color: var(--c-on-navy-100);
			font-size: 1.05rem;
		}
		.hero__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.8rem;
			margin-top: 1.65rem;
		}
		.hero__actions .btn {
			justify-content: center;
			min-width: 190px;
		}
		.hero__trust {
			display: flex;
			flex-wrap: wrap;
			gap: 0.65rem 1.25rem;
			list-style: none;
			padding: 0;
			margin: 1.5rem 0 0;
			color: var(--c-on-navy-200);
			font-size: 0.78rem;
		}
		.hero__trust li::before {
			content: "✓";
			margin-right: 0.4rem;
			color: var(--c-green);
			font-weight: 900;
		}

		.spotlight {
			min-width: 0;
			padding: 1.25rem;
			border: 1px solid color-mix(in srgb, var(--c-white) 75%, var(--c-border));
			border-radius: var(--radius);
			background: color-mix(in srgb, var(--c-white) 96%, var(--c-blue-tint));
			color: var(--c-ink);
			box-shadow: 0 28px 60px color-mix(in srgb, var(--c-navy-deep) 40%, transparent);
		}
		.spotlight__label {
			display: inline-flex;
			padding: 0.3rem 0.65rem;
			border-radius: 999px;
			background: var(--c-mint);
			color: var(--c-green-dark);
			font-size: 0.66rem;
			font-weight: 800;
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}
		.spotlight__layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(130px, 0.75fr);
			align-items: center;
			gap: 1rem;
			margin-top: 0.8rem;
		}
		.spotlight__code {
			margin: 0 0 0.2rem;
			color: var(--c-muted);
			font-size: 0.78rem;
			font-weight: 700;
		}
		.spotlight h2 {
			margin: 0;
			font-size: clamp(1.35rem, 2vw, 1.8rem);
		}
		.spotlight__price {
			margin: 0.35rem 0 0.85rem;
			font-size: 1.25rem;
			font-weight: 850;
		}
		.spotlight__media {
			display: grid;
			place-items: center;
			min-width: 0;
			aspect-ratio: 1 / 1.15;
			padding: 0.75rem;
			border-radius: var(--radius-sm);
			background: linear-gradient(180deg, var(--c-surface), var(--c-surface-2));
		}
		.spotlight__media img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			mix-blend-mode: multiply;
		}
		.spotlight__media svg {
			width: 54%;
			max-height: 170px;
		}
		.spotlight__sizes {
			display: flex;
			align-items: center;
			gap: 0.7rem;
			margin-top: 1rem;
			padding-top: 0.8rem;
			border-top: 1px solid var(--c-border);
			color: var(--c-muted);
			font-size: 0.7rem;
		}
		.spotlight__sizes ul {
			display: flex;
			flex-wrap: wrap;
			gap: 0.35rem;
			list-style: none;
			padding: 0;
			margin: 0;
		}
		.spotlight__sizes li {
			padding: 0.25rem 0.55rem;
			border-radius: 999px;
			background: var(--c-surface-2);
			color: var(--c-ink);
			font-weight: 700;
		}

		.trust-strip {
			border-bottom: 1px solid var(--c-border);
			background: var(--c-white);
			box-shadow: 0 8px 24px color-mix(in srgb, var(--c-navy) 7%, transparent);
		}
		.trust-strip__grid {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
		.trust-strip a {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			min-width: 0;
			padding: 1.25rem 1rem;
			text-decoration: none;
		}
		.trust-strip a + a {
			border-left: 1px solid var(--c-border);
		}
		.trust-strip__icon {
			display: grid;
			place-items: center;
			flex: none;
			width: 34px;
			height: 34px;
			border-radius: 50%;
			background: var(--c-mint);
			color: var(--c-green-dark);
			font-weight: 850;
		}
		.trust-strip strong,
		.trust-strip small {
			display: block;
		}
		.trust-strip strong {
			font-size: 0.84rem;
		}
		.trust-strip small {
