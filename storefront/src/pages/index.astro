---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { medusa, getDefaultRegionId } from "../lib/medusa";
import { ORGANIZATION_ID, SITE_NAME, SITE_URL } from "../lib/site";

const regionId = await getDefaultRegionId();

const { products: allProducts } = await medusa.store.product.list({
	region_id: regionId,
	fields:
		"id,title,handle,thumbnail,metadata,*variants,*variants.calculated_price",
	limit: 20,
});

// Prefer peptides (products carrying a research_code) for the homepage so the
// intended design is showcased; fall back to whatever exists otherwise.
const isPeptide = (p: (typeof allProducts)[number]) =>
	typeof (p.metadata as Record<string, unknown> | null)?.research_code ===
	"string";
const peptides = allProducts.filter(isPeptide);
const products = (peptides.length ? peptides : allProducts).slice(0, 6);

const spotlight = products[0];

function priceOf(product: (typeof products)[number] | undefined) {
	if (!product) return null;
	const amounts = (product.variants ?? [])
		.map((v) => v.calculated_price?.calculated_amount)
		.filter((a): a is number => typeof a === "number");
	if (!amounts.length) return null;
	const currency =
		product.variants?.[0]?.calculated_price?.currency_code ?? "eur";
	return new Intl.NumberFormat("de-DE", {
		style: "currency",
		currency: currency.toUpperCase(),
	}).format(Math.min(...amounts));
}

const spotlightPrice = priceOf(spotlight);

const features = [
	{
		title: "Analyse geprüft",
		body: "Chargenbezogene Qualitätsprüfung mit nachvollziehbarer Zertifikatszuordnung.",
	},
	{
		title: "Lyophilisierte Vials",
		body: "Peptide als Pulvervials für Forschungs- und Analysezwecke.",
	},
	{
		title: "Diskreter Versand",
		body: "Zustellung in 1–3 Werktagen nach Zahlungseingang, neutral verpackt.",
	},
	{
		title: "Support & COA",
		body: "Support zu Produktdaten und verfügbaren Packgrößen.",
	},
];

const categories = [
	{
		label: "Forschungsbereich",
		title: "Regenerationsforschung",
		body: "Peptide und Fragmente für Zellkommunikations-, Gewebe- und Signalwegmodelle.",
	},
	{
		label: "Forschungsbereich",
		title: "Stoffwechsel-Forschung",
		body: "Forschungskategorien für analytische Laborprojekte zu metabolischen Mechanismen.",
	},
	{
		label: "Peptidgruppe",
		title: "Signal- & Fragmentpeptide",
		body: "Strukturierte Auswahl an Fragment- und Signalpeptiden mit Produktbezogener Dokumentation.",
	},
	{
		label: "Forschungsbereich",
		title: "Neuropeptid-Forschung",
		body: "Forschungsbezogene Projekte zu neuronalen Signalwegen und Modellforschung.",
	},
	{
		label: "Bundles",
		title: "Peptid-Stacks",
		body: "Bundles aus einzeln dokumentierten Komponenten mit separater Zertifikatslage.",
	},
	{
		label: "Zubehör",
		title: "Laborbedarf",
		body: "Ergänzende Produkte für Lagerung, Handling und Dokumentation im Labor.",
	},
];

const faqs = [
	{
		q: "Wofür sind die Produkte vorgesehen?",
		a: "Alle Produkte sind ausschließlich für Forschungs-, Analyse- und Laborzwecke bestimmt. Keine medizinische Beratung, keine Anwendungshinweise.",
	},
	{
		q: "Gibt es ein Zertifikat zum Produkt?",
		a: "Der Zertifikatsstatus wird pro Produkt und Packgröße ausgewiesen. [Platzhalter – tatsächliche COA-Verfügbarkeit vor Veröffentlichung bestätigen.]",
	},
	{
		q: "Wie läuft die Bestellung ab?",
		a: "Produkte in den Warenkorb legen, Packgröße wählen und über den Checkout abschließen. [Platzhalter – Versand-/Zahlungsdetails ergänzen.]",
	},
	{
		q: "Kann ich größere Mengen bestellen?",
		a: "Für Laborbestellungen größerer Mengen kontaktieren Sie bitte den Support.",
	},
];

// --- SEO ---------------------------------------------------------------
// WebSite + FAQPage, built from the FAQ rendered further down so the markup
// and the structured data can never drift apart.
const homeJsonLd = [
	{
		"@type": "WebSite",
		"@id": `${SITE_URL}/#website`,
		url: SITE_URL,
		name: SITE_NAME,
		publisher: { "@id": ORGANIZATION_ID },
		inLanguage: "de-DE",
	},
	{
		"@type": "FAQPage",
		"@id": `${SITE_URL}/#faq`,
		mainEntity: faqs.map((faq) => ({
			"@type": "Question",
			name: faq.q,
			acceptedAnswer: { "@type": "Answer", text: faq.a },
		})),
	},
];
---

<BaseLayout
	title="Peptide kaufen – Forschungspeptide für Labor und Wissenschaft"
	description="Forschungspeptide mit dokumentierter Reinheit und Packgrößen für wissenschaftliche und laborinterne Zwecke. Ausschließlich für Forschungszwecke."
	rawTitle
	wide
	jsonLd={homeJsonLd}
>
	<!-- HERO -->
	<section class="hero">
		<div class="hero__inner container">
			<div class="hero__copy">
				<span class="eyebrow eyebrow--dark">Geprüfte Forschungspeptide</span>
				<h1>Peptide kaufen in Deutschland – für Forschung und Analyse</h1>
				<p>
					Forschungspeptide für wissenschaftliche Anwendungen und Laborzwecke.
					Klare Produktdaten, Packgrößen und Zertifikatsstatus auf einen Blick.
				</p>
				<div class="hero__actions">
					<a href="/produkte" class="btn btn--green">Peptide ansehen</a>
					<a href="/about" class="btn btn--ghost">Mehr erfahren</a>
				</div>
				<ul class="hero__trust">
					<li>Diskreter Versand</li>
					<li>Packgrößen 5–500 mg</li>
					<li>COA-Zertifikat je Produkt*</li>
					<li>Klare Produktdaten</li>
				</ul>
			</div>

			{
				spotlight && (
					<a class="spotlight" href={`/produkte/${spotlight.handle}`}>
						<div class="spotlight__head">
							<span>Produktdaten</span>
							<span class="spotlight__code">
								{typeof spotlight.metadata?.research_code === "string"
									? spotlight.metadata.research_code
									: "Research Use Only"}
							</span>
						</div>
						<div class="spotlight__grid">
							<div class="spotlight__info">
								<h2>{spotlight.title}</h2>
								{spotlightPrice && <p class="spotlight__price">ab {spotlightPrice}</p>}
								<dl>
									<div>
										<dt>Reinheit</dt>
										<dd>
											{typeof spotlight.metadata?.purity === "string"
												? spotlight.metadata.purity
												: "—"}
										</dd>
									</div>
									<div>
										<dt>Packgrößen</dt>
										<dd>{(spotlight.variants ?? []).map((v) => v.title).join(" / ") || "—"}</dd>
									</div>
									<div>
										<dt>COA-Zertifikat</dt>
										<dd>
											{typeof spotlight.metadata?.coa_status === "string"
												? spotlight.metadata.coa_status
												: "—"}
										</dd>
									</div>
								</dl>
								<span class="btn btn--green btn--sm">Produkt ansehen</span>
							</div>
							<div class="spotlight__media">
								{spotlight.thumbnail ? (
									<img src={spotlight.thumbnail} alt={spotlight.title} width="200" height="200" />
								) : (
									<svg viewBox="0 0 80 100" aria-hidden="true">
										<rect x="30" y="6" width="20" height="10" rx="2" fill="#c9d3df" />
										<path d="M28 16h24v70a12 12 0 0 1-24 0V16Z" fill="#d9a441" />
										<rect x="34" y="24" width="12" height="26" rx="2" fill="#fff" opacity="0.35" />
									</svg>
								)}
							</div>
						</div>
					</a>
				)
			}
		</div>
	</section>

	<!-- COMPARISON ROW -->
	<section class="container section">
		<span class="eyebrow">Alle Produkte</span>
		<div class="section__head">
			<h2>Forschungspeptide direkt vergleichen</h2>
			<a href="/produkte" class="section__link">Alle Produkte ansehen →</a>
		</div>
		<p class="section__lead">
			Packgrößen, Preis und Zertifikatsstatus auf einen Blick. Öffne ein Produkt,
			um Reinheit und Varianten zu prüfen.
		</p>
		<div class="row">
			{products.map((product) => <ProductCard product={product} />)}
		</div>
	</section>

	<!-- FEATURE STRIP -->
	<section class="strip">
		<div class="container strip__grid">
			{
				features.map((f) => (
					<div class="strip__card">
						<h3>{f.title}</h3>
						<p>{f.body}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- CATEGORIES -->
	<section class="container section">
		<span class="eyebrow">Kategorien</span>
		<h2>Nach Forschungsbereich auswählen</h2>
		<p class="section__lead">
			Wähle zwischen Forschungsbereichen, Peptidgruppen und ergänzendem Laborbedarf.
		</p>
		<div class="cat-grid">
			{
				categories.map((c) => (
					<a href="/produkte" class="cat">
						<span class="cat__label">{c.label}</span>
						<h3>{c.title}</h3>
						<p>{c.body}</p>
						<span class="cat__more">Öffnen →</span>
					</a>
				))
			}
		</div>
	</section>

	<!-- FAQ -->
	<section class="container section">
		<h2>Häufig gestellte Fragen</h2>
		<div class="faq">
			{
				faqs.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<!-- CTA BAND -->
	<section class="container">
		<div class="cta">
			<div>
				<h2>Prüfe Produkte anhand klarer Analyseangaben</h2>
				<ul>
					<li>Zertifikatsstatus pro Produkt sichtbar.</li>
					<li>Packgröße und Preis übersichtlich vergleichen.</li>
					<li>Klare Produktdaten und diskreter Versand.</li>
				</ul>
			</div>
			<a href="/produkte" class="btn btn--green">Zum Shop →</a>
		</div>
	</section>

	<style>
		/* HERO */
		.hero {
			background: radial-gradient(120% 120% at 80% 0%, var(--c-navy-2), var(--c-navy) 55%, var(--c-navy-deep));
			color: var(--c-white);
		}
		.hero__inner {
			display: grid;
			grid-template-columns: 1.05fr 0.95fr;
			gap: 3rem;
			align-items: center;
			padding-block: 4rem 4.5rem;
		}
		.hero h1 {
			font-size: clamp(2rem, 4vw, 3rem);
			font-weight: 800;
			margin: 0 0 1rem;
		}
		.hero__copy > p {
			color: var(--c-on-navy-300);
			font-size: 1.05rem;
			max-width: 46ch;
			margin: 0 0 1.6rem;
		}
		.eyebrow--dark {
			background: rgba(255, 255, 255, 0.1);
			color: var(--c-on-navy-100);
		}
		.hero__actions {
			display: flex;
			gap: 0.8rem;
			flex-wrap: wrap;
		}
		.hero__trust {
			list-style: none;
			display: flex;
			flex-wrap: wrap;
			gap: 1.2rem;
			padding: 0;
			margin: 1.8rem 0 0;
			font-size: 0.82rem;
			color: var(--c-on-navy-400);
		}
		.hero__trust li {
			display: flex;
			align-items: center;
			gap: 0.4rem;
		}
		.hero__trust li::before {
			content: "✓";
			color: var(--c-green);
			font-weight: 800;
		}

		/* Spotlight card */
		.spotlight {
			display: block;
			background: var(--c-white);
			color: var(--c-ink);
			border-radius: 18px;
			padding: 1.4rem;
			text-decoration: none;
			box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
		}
		.spotlight__head {
			display: flex;
			justify-content: space-between;
			font-size: 0.72rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--c-muted);
			margin-bottom: 0.8rem;
		}
		.spotlight__code {
			color: var(--c-green-dark);
		}
		.spotlight__grid {
			display: grid;
			grid-template-columns: 1fr 0.8fr;
			gap: 1rem;
			align-items: center;
		}
		.spotlight__info h2 {
			font-size: 1.5rem;
			margin: 0;
		}
		.spotlight__price {
			font-size: 1.15rem;
			font-weight: 800;
			color: var(--c-navy);
			margin: 0.2rem 0 0.9rem;
		}
		.spotlight dl {
			margin: 0 0 1rem;
			display: grid;
			gap: 0.4rem;
		}
		.spotlight dl div {
			display: flex;
			justify-content: space-between;
			font-size: 0.85rem;
			border-bottom: 1px solid var(--c-border);
			padding-bottom: 0.35rem;
		}
		.spotlight dt {
			color: var(--c-muted);
		}
		.spotlight dd {
			margin: 0;
			font-weight: 600;
		}
		.spotlight__media {
			background: linear-gradient(180deg, var(--c-surface), var(--c-surface-2));
			border-radius: 12px;
			display: grid;
			place-items: center;
			aspect-ratio: 3 / 4;
			padding: 1rem;
		}
		.spotlight__media img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			mix-blend-mode: multiply;
		}
		.spotlight__media svg {
			width: 60%;
		}

		/* Section scaffolding */
		.section {
			padding-block: 3.5rem 1rem;
		}
		.section__head {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.section h2 {
			font-size: clamp(1.5rem, 2.5vw, 2rem);
		}
		.section__lead {
			color: var(--c-muted);
			max-width: 60ch;
			margin: 0.25rem 0 1.75rem;
		}
		.section__link {
			text-decoration: none;
			font-weight: 600;
			color: var(--c-green-dark);
			white-space: nowrap;
		}

		.row {
			display: grid;
			grid-auto-flow: column;
			grid-auto-columns: minmax(210px, 1fr);
			gap: 1.2rem;
			overflow-x: auto;
			padding-bottom: 0.5rem;
			scroll-snap-type: x mandatory;
		}
		.row > * {
			scroll-snap-align: start;
		}

		/* Feature strip */
		.strip {
			background: var(--c-blue-tint);
			margin-top: 2.5rem;
		}
		.strip__grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1rem;
			padding-block: 2rem;
		}
		.strip__card {
			background: var(--c-white);
			border: 1px solid var(--c-border);
			border-radius: var(--radius);
			padding: 1.1rem 1.2rem;
		}
		.strip__card h3 {
			font-size: 0.98rem;
			margin: 0 0 0.35rem;
		}
		.strip__card p {
			margin: 0;
			font-size: 0.85rem;
			color: var(--c-muted);
		}

		/* Categories */
		.cat-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1rem;
		}
		.cat {
			display: block;
			background: var(--c-cream-soft);
			border: 1px solid var(--c-cream-border);
			border-radius: var(--radius);
			padding: 1.3rem;
			text-decoration: none;
			color: inherit;
			transition: border-color 0.15s ease;
		}
		.cat:hover {
			border-color: var(--c-gold);
		}
		.cat__label {
			font-size: 0.68rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--c-gold);
		}
		.cat h3 {
			font-size: 1.1rem;
			margin: 0.4rem 0 0.4rem;
		}
		.cat p {
			font-size: 0.85rem;
			color: var(--c-muted);
			margin: 0 0 0.8rem;
		}
		.cat__more {
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--c-green-dark);
		}

		/* FAQ */
		.faq {
			max-width: 760px;
		}
		.faq details {
			border: 1px solid var(--c-border);
			border-radius: var(--radius-sm);
			padding: 0.9rem 1.1rem;
			margin-bottom: 0.7rem;
			background: var(--c-white);
		}
		.faq summary {
			cursor: pointer;
			font-weight: 600;
			list-style: none;
		}
		.faq summary::-webkit-details-marker {
			display: none;
		}
		.faq summary::after {
			content: "+";
			float: right;
			color: var(--c-green);
			font-weight: 800;
		}
		.faq details[open] summary::after {
			content: "–";
		}
		.faq p {
			margin: 0.7rem 0 0;
			color: var(--c-muted);
			font-size: 0.9rem;
		}

		/* CTA band */
		.cta {
			background: var(--c-cream);
			border-radius: 18px;
			padding: 2rem 2.2rem;
			margin: 2.5rem 0;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1.5rem;
			flex-wrap: wrap;
		}
		.cta h2 {
			margin: 0 0 0.6rem;
			font-size: 1.4rem;
		}
		.cta ul {
			margin: 0;
			padding-left: 1.1rem;
			color: var(--c-gold-ink-soft);
			font-size: 0.9rem;
		}

		@media (max-width: 900px) {
			.hero__inner {
				grid-template-columns: 1fr;
			}
			.strip__grid {
				grid-template-columns: repeat(2, 1fr);
			}
			.cat-grid {
				grid-template-columns: 1fr;
			}
			.spotlight__grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</BaseLayout>
