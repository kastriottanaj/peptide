# Copy to `.env` and fill in every blank. `.env` is git-ignored — keep it that way.

# Origins allowed to call the store / admin / auth APIs. Comma-separated, no
# trailing slash. Keep this to origins you control: an entry here can make
# credentialed cross-origin calls to these APIs, so the scaffold's
# https://docs.medusajs.com entries are deliberately gone. The storefront dev
# server is :4321, the admin dev server :5173.
STORE_CORS=http://localhost:4321
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# REDIS_URL backs the event bus, cache and workflow engine *and* HTTP session
# storage. Without it sessions fall back to express-session's MemoryStore, which
# drops every login on restart and never evicts.
REDIS_URL=redis://localhost:6379
# Namespace for session keys; leave unset to use peptides:sess:.
REDIS_PREFIX=
FILE_UPLOAD_DIR=
FILE_BACKEND_URL=

# Signing keys for admin/customer JWTs and for session cookies.
#
# LEAVE BLANK HERE. Anyone who knows these values can mint a valid admin session
# for this store, so a value committed to the repository is worth no more than
# no authentication at all — which is what the previous `supersecret` default
# amounted to. Generate a distinct one per environment with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# medusa-config.ts refuses to boot under NODE_ENV=production unless both are set
# to something other than the old placeholder.
JWT_SECRET=
COOKIE_SECRET=

DATABASE_URL=
DB_NAME=medusa_peptides

# Google Analytics 4 reporting.
#
# GA4_PROPERTY_ID is the numeric property id from the GA4 admin; the
# G-XXXXXXXXXX measurement id is a separate value and the two are not
# interchangeable. GA4_CACHE_TTL_SECONDS bounds how long a report response is
# reused before the Data API is queried again.
#
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=
GA4_CACHE_TTL_SECONDS=60

# Authentication. Exactly one of the three below, in this precedence order.
# LEAVE THEM ALL BLANK HERE — each one grants API access on its own, so a value
# committed to this template is a leaked credential regardless of who can read
# the repo.
#
# 1. GA4_SERVICE_ACCOUNT_JSON — the whole service-account key as one line of
#    JSON. The production path: nothing has to exist on the host filesystem.
#    Newlines inside private_key may stay escaped as \n; they are normalised
#    when parsed.
GA4_SERVICE_ACCOUNT_JSON=
#
# 2. GOOGLE_APPLICATION_CREDENTIALS — absolute path to a key file. The local
#    development path. Keep the file itself outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
#
# 3. GA4_ALLOW_DEFAULT_CREDENTIALS=true — use Application Default Credentials
#    from the hosting environment (workload identity, an attached service
#    account). Opt-in only, and only `true` opts in: ADC
#    resolves to a GCE metadata identity or to whoever last ran
#    `gcloud auth login`, so treating a forgotten variable as "just use ADC"
#    would silently report on whatever property that other identity can reach
#    instead of failing.
GA4_ALLOW_DEFAULT_CREDENTIALS=

# --- Admin analytics dashboard -----------------------------------------------
# The Medusa-side half of /app/analytics. See docs/analytics-dashboard.md.
#
# ANALYTICS_TIMEZONE decides which midnight bounds a reporting day. Every
# Medusa figure and every chart label uses it, so a server running in UTC does
# not push a 01:00 CEST order into the previous day. An unknown zone falls back
# to Europe/Berlin rather than failing the request.
ANALYTICS_TIMEZONE=Europe/Berlin
#
# ANALYTICS_CACHE_TTL_SECONDS caches an assembled report. These cost database
# work rather than a metered third-party quota, so the default is short: a
# merchant who has just marked an order as paid and reloads should see it.
# 0 disables caching; values above 600 are clamped.
ANALYTICS_CACHE_TTL_SECONDS=30
