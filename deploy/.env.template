# Medusa + storefront-build environment for peptideeinkaufen.de.
#
# Lives at /srv/peptides/.env, mode 600, owned by the `medusa` user. NEVER
# commit the filled version — .gitignore covers .env and git history is
# permanent.
#
# deploy/provision.sh creates this file and fills in everything it can generate
# itself: DATABASE_URL (with a fresh password), REDIS_URL, JWT_SECRET and
# COOKIE_SECRET. What is left blank below is what you must supply.
#
# Read by systemd as an EnvironmentFile, which does NOT do shell expansion and
# does NOT strip quotes. Write plain values: KEY=value, no quoting, no $(...),
# and no references to other variables.

# ---------------------------------------------------------------------------
# Generated by provision.sh — do not edit unless you know why
# ---------------------------------------------------------------------------
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# These sign admin and customer sessions. Anyone who knows them can mint a valid
# admin session. medusa-config.ts refuses to boot under NODE_ENV=production if
# either is unset or still the old `supersecret` placeholder.
#   openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=

# ---------------------------------------------------------------------------
# CORS — which origins may call the store, admin and auth APIs
# ---------------------------------------------------------------------------
# medusa-config.ts throws in production rather than falling back to a framework
# default, so these must be right.
STORE_CORS=https://peptideeinkaufen.de,https://www.peptideeinkaufen.de
ADMIN_CORS=https://api.peptideeinkaufen.de
AUTH_CORS=https://api.peptideeinkaufen.de

# ---------------------------------------------------------------------------
# Storefront build
# ---------------------------------------------------------------------------
# Baked into the static build by deploy.sh; not read at runtime.
#
# PUBLIC_MEDUSA_PUBLISHABLE_KEY does not exist until Medusa is running and an
# admin user has created it, so the first deploy is two-phase — see
# docs/deploy.md. Leave it blank for phase 1; deploy.sh will skip the storefront
# build and tell you so.
PUBLIC_SITE_URL=https://peptideeinkaufen.de
PUBLIC_MEDUSA_BACKEND_URL=https://api.peptideeinkaufen.de
PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Measurement — docs/analytics.md
# ---------------------------------------------------------------------------
# Both optional. Baked into the static build, so changing either one requires a
# rebuild and redeploy before it has any effect.
#
# PUBLIC_GA_MEASUREMENT_ID is the whole on/off switch for analytics: unset means
# no Google script, no consent dialog, and a Datenschutz page that says no
# tracking is in use. With it set, GA4 still loads only after explicit consent.
PUBLIC_GA_MEASUREMENT_ID=
#
# Search Console meta-tag verification. NOT the method in use: the gate answers
# 401 to Googlebot, so the tag can never be read. Verification runs over a DNS
# TXT record instead. Only useful for a URL-prefix property after un-gating.
PUBLIC_GOOGLE_SITE_VERIFICATION=
#
# IndexNow — docs/indexnow.md. Unset means no key file is published and no deploy
# submits anything; that is the intended state until launch. Setting it makes
# every deploy push the URLs whose HTML changed to Bing, Yandex and the other
# participants, so do not set it while the catalog still carries placeholder
# purity values. 8-128 chars of [A-Za-z0-9-]; served publicly at /<key>.txt.
INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# Orders — docs/specs/2026-07-30-orders-closed.md
# ---------------------------------------------------------------------------
# Whether the shop accepts orders. UNSET MEANS CLOSED, and only the exact string
# `true` opens it — a forgotten variable must not open a shop that cannot take
# money. One value, two consumers: medusa.service reads it at runtime and refuses
# cart completion with 503, and deploy.sh writes PUBLIC_ORDERS_ENABLED from it
# into the storefront build, which then hides add-to-cart and the checkout form.
#
# Open it together with the bank details below, not before: an order placed
# without them cannot be paid.
ORDERS_ENABLED=

# ---------------------------------------------------------------------------
# Bank details — go-live-checklist.md §1
# ---------------------------------------------------------------------------
# BLOCKER: until these are real, every order confirmation shows PLATZHALTER and
# an orange warning telling the customer not to transfer. Ordering is closed
# (ORDERS_ENABLED above) precisely because these are empty.
PUBLIC_BANK_ACCOUNT_HOLDER=
PUBLIC_BANK_IBAN=
PUBLIC_BANK_BIC=
PUBLIC_BANK_NAME=
