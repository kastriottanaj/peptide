# Production environment for peptideeinkaufen.de.
#
# Copy to /srv/peptides/.env on the server and fill in. NEVER commit the filled
# version — .gitignore covers .env, and git history is permanent.
#
#   cp deploy/.env.template /srv/peptides/.env
#   chmod 600 /srv/peptides/.env
#
# This file is read by docker-compose as an `env_file`, which does NOT do shell
# interpolation: values are taken literally. Do not quote them, and do not
# escape `$` — that matters for GATE_PASSWORD_HASH below.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
SITE_DOMAIN=peptideeinkaufen.de

# Where Let's Encrypt sends expiry warnings. A real mailbox you read.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Pre-launch gate
# ---------------------------------------------------------------------------
# The storefront sits behind HTTP basic auth until the go-live checklist clears.
# Generate the hash (it starts with $2a$ and contains $ — paste it verbatim):
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
#
GATE_USER=
GATE_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=medusa_peptides
POSTGRES_USER=medusa
# openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Medusa secrets
# ---------------------------------------------------------------------------
# These sign admin and customer sessions. Anyone who knows them can mint a valid
# admin session. One unique value per environment:
#
#   openssl rand -base64 32
#
# medusa-config.ts refuses to boot under NODE_ENV=production if either is unset
# or still the old `supersecret` placeholder.
JWT_SECRET=
COOKIE_SECRET=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Which origins may call the store, admin and auth APIs. medusa-config.ts throws
# in production rather than falling back to a framework default.
STORE_CORS=https://peptideeinkaufen.de,https://www.peptideeinkaufen.de
ADMIN_CORS=https://api.peptideeinkaufen.de
AUTH_CORS=https://api.peptideeinkaufen.de

# ---------------------------------------------------------------------------
# Storefront build
# ---------------------------------------------------------------------------
# Baked into the static build by deploy.sh, not read at runtime.
#
# PUBLIC_MEDUSA_PUBLISHABLE_KEY does not exist until Medusa is running and an
# admin user has created it, so the first deploy is two-phase — see
# docs/deploy.md. Leave it blank for phase 1.
PUBLIC_SITE_URL=https://peptideeinkaufen.de
PUBLIC_MEDUSA_BACKEND_URL=https://api.peptideeinkaufen.de
PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Bank details — go-live-checklist.md §1
# ---------------------------------------------------------------------------
# BLOCKER: until these are real, every order confirmation shows PLATZHALTER and
# an orange warning telling the customer not to transfer. The shop must not be
# un-gated before they are set.
PUBLIC_BANK_ACCOUNT_HOLDER=
PUBLIC_BANK_IBAN=
PUBLIC_BANK_BIC=
PUBLIC_BANK_NAME=
