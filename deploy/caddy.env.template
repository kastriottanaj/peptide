# Caddy environment for peptideeinkaufen.de.
#
# Lives at /srv/peptides/caddy.env, mode 640, owned root:caddy. Wired in by
# provision.sh through a systemd drop-in at
# /etc/systemd/system/caddy.service.d/override.conf.
#
# Deliberately separate from /srv/peptides/.env — Caddy runs as the `caddy` user
# and does not need the database password or the Medusa signing secrets.
#
# systemd's EnvironmentFile does no shell expansion and does not strip quotes:
# write plain KEY=value.

SITE_DOMAIN=peptideeinkaufen.de
SITE_GATED=1

# Root-controlled imports. Keep these fixed; deploy.sh atomically replaces the
# file/symlink at each path and validates the complete config before reload.
MAINTENANCE_CONFIG=/srv/peptides/maintenance.caddy
CSP_CONFIG=/srv/peptides/csp-current

# Where Let's Encrypt sends expiry warnings. A real mailbox you actually read.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Pre-launch gate
# ---------------------------------------------------------------------------
# The storefront sits behind HTTP basic auth until the go-live checklist clears.
# Generate the hash on the server and paste it verbatim — it starts with $2a$
# and contains $ characters, which must NOT be quoted or escaped here:
#
#   caddy hash-password
#
GATE_USER=
GATE_PASSWORD_HASH=
