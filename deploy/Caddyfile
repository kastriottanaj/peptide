# Caddy config for peptideeinkaufen.de.
# Installed to /etc/caddy/Caddyfile by deploy/provision.sh.
#
# Certificates are issued automatically from Let's Encrypt on first request per
# hostname, so the DNS A records must resolve to this box before Caddy starts.
#
# Variables come from /srv/peptides/caddy.env, wired in by a systemd drop-in at
# /etc/systemd/system/caddy.service.d/override.conf. That file is deliberately
# separate from /srv/peptides/.env: Caddy runs as the `caddy` user and has no
# business reading the database password or the Medusa signing secrets.
#
# The pre-launch gate (basic auth plus a site-wide X-Robots-Tag) was removed on
# 2026-07-29 by explicit decision: the storefront is public and indexable. The
# four legal pages keep their own `noindex` from the `draft` prop in
# LegalLayout — that is per-page and owned by the storefront, not by Caddy.
{
	email {$ACME_EMAIL}
	# The default localhost:2019 endpoint is unauthenticated. Medusa and build
	# processes can open loopback sockets, so keep the configuration API on a
	# caddy-owned Unix socket that those identities cannot traverse.
	admin unix//run/caddy/admin.sock
	persist_config off
	# Uncomment to exercise the whole issuance path without burning Let's
	# Encrypt rate limits while DNS is still settling:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

import {$MAINTENANCE_CONFIG}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"

		# Required for WebMCP: browsers only expose navigator.modelContext to a
		# page that sends this. See README.md — the tools register in code but
		# no browser will call them without it.
		Permissions-Policy "tools=(self)"

		-Server
		-X-Powered-By
	}
}

# Only 404s get the custom page. The matcher has to gate `file_server` too, not
# just the rewrite: a bare `file_server` here runs for EVERY error and would
# serve the requested page out of the error handler, masking the real status.
# That is what once turned the pre-launch basic auth into a suggestion — a 401
# that still returned the page body. Anything that is not a 404 falls through to
# Caddy's default error response, which preserves the status.
(storefront_errors) {
	handle_errors {
		@not_found expression {err.status_code} == 404
		handle @not_found {
			import security_headers
			rewrite * /404.html
			file_server
		}
	}
}

# ---------------------------------------------------------------------------
# Storefront — static files produced by deploy.sh
# ---------------------------------------------------------------------------
{$SITE_DOMAIN} {
	route {
		import security_headers
		import {$CSP_CONFIG}
		encode zstd gzip

		# Astro fingerprints everything under /_astro/, so those URLs are
		# immutable and can be cached hard.
		@immutable path /_astro/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# Everything else must revalidate, or a deploy takes a day to become
		# visible. Matching by negation rather than *.html on purpose: almost
		# every page here is served as a directory index (/produkte/,
		# /wissen/lexikon/), whose request path does not end in .html and would
		# miss a *.html matcher.
		@revalidate not path /_astro/*
		header @revalidate Cache-Control "public, max-age=0, must-revalidate"

		# Root-only loopback verification reaches the candidate release before it
		# is published. Both conditions are required, so an Internet client
		# cannot opt into the bypass by forging the header.
		@candidate {
			remote_ip 127.0.0.1 ::1
			header X-Peptides-Candidate 1
		}
		handle @candidate {
			root * /srv/peptides/storefront-candidate
			file_server
		}

		handle {
			# `handle` sorts its children by directive order unless they are
			# wrapped in a route. Maintenance stays first so a deploy can prove
			# the public apex is actually fail-closed while a release swaps.
			route {
				import storefront_maintenance

				root * /srv/peptides/storefront-current
				file_server
			}
		}
	}

	import storefront_errors
}

www.{$SITE_DOMAIN} {
	route {
		import security_headers
		import storefront_maintenance
		redir https://{$SITE_DOMAIN}{uri} permanent
	}

	import storefront_errors
}

# ---------------------------------------------------------------------------
# Medusa — store API and the admin dashboard at /app
# ---------------------------------------------------------------------------
# The store API requires a publishable key and the admin has its own login, so
# this hostname carries no site-level authentication of its own. Unlike the
# storefront it stays `noindex, no-store`: an API surface has nothing to gain
# from being indexed or cached by intermediaries.
api.{$SITE_DOMAIN} {
	route {
		import security_headers
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow"
		}
		import api_maintenance

		reverse_proxy 127.0.0.1:9000 {
			header_down -Server
			header_down -X-Powered-By
		}
	}
}
