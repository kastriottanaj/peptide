# Caddy config for peptideeinkaufen.de.
# Installed to /etc/caddy/Caddyfile by deploy/provision.sh.
#
# Certificates are issued automatically from Let's Encrypt on first request per
# hostname, so the DNS A records must resolve to this box before Caddy starts.
#
# Variables come from /srv/peptides/caddy.env, wired in by a systemd drop-in at
# /etc/systemd/system/caddy.service.d/override.conf. That file is deliberately
# separate from /srv/peptides/.env: Caddy runs as the `caddy` user and has no
# business reading the database password or the Medusa signing secrets.
#
# GATE_PASSWORD_HASH is a bcrypt hash containing `$`. systemd's EnvironmentFile
# does no shell expansion, so paste it verbatim — unquoted, unescaped.
{
	email {$ACME_EMAIL}
	# The default localhost:2019 endpoint is unauthenticated. Medusa and build
	# processes can open loopback sockets, so keep the configuration API on a
	# caddy-owned Unix socket that those identities cannot traverse.
	admin unix//run/caddy/admin.sock
	persist_config off
	# Uncomment to exercise the whole issuance path without burning Let's
	# Encrypt rate limits while DNS is still settling:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

import {$MAINTENANCE_CONFIG}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"

		# Required for WebMCP: browsers only expose navigator.modelContext to a
		# page that sends this. See README.md — the tools register in code but
		# no browser will call them without it.
		Permissions-Policy "tools=(self)"

		-Server
		-X-Powered-By
	}
}

(private_gate_error) {
	handle_errors {
		@unauthorized expression {err.status_code} == 401
		handle @unauthorized {
			import security_headers
			header {
				Cache-Control "private, no-store"
				Content-Length "0"
				WWW-Authenticate "Basic realm=\"Private preview\""
				X-Robots-Tag "noindex, nofollow"
			}
			respond "" 401
		}

		@not_found expression {err.status_code} == 404
		handle @not_found {
			import security_headers
			rewrite * /404.html
			file_server
		}
	}
}

# ---------------------------------------------------------------------------
# Storefront — static files produced by deploy.sh
# ---------------------------------------------------------------------------
{$SITE_DOMAIN} {
	route {
		import security_headers
		import {$CSP_CONFIG}
		header {
			Cache-Control "private, no-store"
			X-Robots-Tag "noindex, nofollow"
		}
		encode zstd gzip

		# Root-only loopback verification reaches the candidate without a gate
		# password. Both conditions are required, so an Internet client cannot
		# opt into the bypass by forging the header.
		@candidate {
			remote_ip 127.0.0.1 ::1
			header X-Peptides-Candidate 1
		}
		handle @candidate {
			root * /srv/peptides/storefront-candidate
			file_server
		}

		# During first-install maintenance there is no prior storefront on which
		# to test the gate. This loopback-only route exercises the real
		# basic-auth hash against the candidate without reopening the public
		# storefront or any state-changing API route.
		@gate_probe {
			remote_ip 127.0.0.1 ::1
			header X-Peptides-Gate-Probe 1
		}
		handle @gate_probe {
			route {
				basic_auth {
					{$GATE_USER} {$GATE_PASSWORD_HASH}
				}
				root * /srv/peptides/storefront-candidate
				file_server
			}
		}

		handle {
			# `handle` sorts its children by directive order unless they are
			# wrapped in a route. Keep maintenance ahead of authentication so
			# a deploy can prove the public apex is actually fail-closed.
			route {
				import storefront_maintenance

				# === PRE-LAUNCH GATE ========================================
				# Removal is a separately approved launch change. SITE_GATED
				# must remain 1 while this committed block is present.
				basic_auth {
					{$GATE_USER} {$GATE_PASSWORD_HASH}
				}
				# === END GATE ===============================================

				root * /srv/peptides/storefront-current
				file_server
			}
		}
	}

	import private_gate_error
}

www.{$SITE_DOMAIN} {
	route {
		import security_headers
		header {
			Cache-Control "private, no-store"
			X-Robots-Tag "noindex, nofollow"
		}
		import storefront_maintenance
		basic_auth {
			{$GATE_USER} {$GATE_PASSWORD_HASH}
		}
		redir https://{$SITE_DOMAIN}{uri} permanent
	}

	import private_gate_error
}

# ---------------------------------------------------------------------------
# Medusa — store API and the admin dashboard at /app
# ---------------------------------------------------------------------------
# Deliberately NOT behind basic auth: the storefront calls this cross-origin
# from the browser, and a cross-origin XHR will not carry basic-auth
# credentials. The store API requires a publishable key and the admin has its
# own login. noindex keeps it out of search results either way.
api.{$SITE_DOMAIN} {
	route {
		import security_headers
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow"
		}
		import api_maintenance

		reverse_proxy 127.0.0.1:9000 {
			header_down -Server
			header_down -X-Powered-By
		}
	}
}
