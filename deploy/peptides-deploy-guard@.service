# Ephemeral liveness guard for a deployment shell. The candidate backend binds
# to this unit, so SIGKILL/SSH loss stops candidate workers instead of allowing
# hidden background database writes to continue indefinitely.

[Unit]
Description=Peptides deploy liveness guard for PID %i
StopWhenUnneeded=yes

[Service]
Type=simple
ExecStart=/usr/bin/tail --pid=%i -f /dev/null
Restart=no
RuntimeMaxSec=1800
TimeoutStopSec=5

User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
