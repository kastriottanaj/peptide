# Scheduled coherent PostgreSQL/upload backup. Installed by deploy/provision.sh.
# deploy/backup.sh parses the root-only application and Restic files as data
# after sanitizing its environment; systemd deliberately does not preload
# either file into the root process.

[Unit]
Description=Encrypted off-host backup for peptideeinkaufen.de
Documentation=https://github.com/kastriottanaj/peptide/blob/main/docs/deploy.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=peptides-backup
WorkingDirectory=/srv/peptides

Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/lib/peptides-backup
Environment=XDG_CACHE_HOME=/var/lib/peptides-backup/.cache
UnsetEnvironment=BASH_ENV ENV CDPATH GLOBIGNORE LD_PRELOAD LD_LIBRARY_PATH
UnsetEnvironment=NODE_OPTIONS NPM_CONFIG_SCRIPT_SHELL npm_config_script_shell
UnsetEnvironment=GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM PYTHONHOME PYTHONPATH
UnsetEnvironment=PGDATABASE PGPASSWORD PGPASSFILE PGSERVICE PGSERVICEFILE
UnsetEnvironment=RESTIC_REPOSITORY RESTIC_PASSWORD RESTIC_PASSWORD_FILE

ExecStartPre=/usr/bin/test -f /srv/peptides/ops-current/deploy/backup.sh
ExecStartPre=/usr/bin/test -r /srv/peptides/backup.env
ExecStartPre=/usr/bin/test ! -e /srv/peptides/recovery-required
ExecStartPre=/usr/bin/test ! -L /srv/peptides/recovery-required
ExecStartPre=/usr/bin/test ! -e /srv/peptides/activation-required
ExecStartPre=/usr/bin/test ! -L /srv/peptides/activation-required
ExecStartPre=/usr/bin/test ! -e /srv/peptides/provision-recovery-required
ExecStartPre=/usr/bin/test ! -L /srv/peptides/provision-recovery-required
# The deployment and backup paths share one lock. A scheduled backup waits for
# an in-flight deploy for at most 30 minutes instead of silently skipping the
# day's recovery point. flock acquires the lock before Bash opens any activated
# operational code.
ExecStart=/usr/bin/flock --exclusive --wait 1800 /srv/peptides/deploy.lock /usr/bin/bash /srv/peptides/ops-current/deploy/backup.sh
TimeoutStartSec=21600
TimeoutStopSec=180

StandardOutput=journal
StandardError=journal
SyslogIdentifier=peptides-backup

# The root process stops/starts only medusa.service and stages local artifacts.
# Each Restic/network command drops to the non-login peptides-backup UID with
# cleared groups/capabilities. The shared state-directory group permits access
# only after backup.sh temporarily grants it to this run's snapshot and
# short-lived credential copies.
StateDirectory=peptides-backup
StateDirectoryMode=0750
UMask=0077
ProtectSystem=strict
ReadOnlyPaths=/srv/peptides

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
# Root-only orchestration parses configuration, reads the mode-0700 Medusa
# state tree, temporarily delegates exact artifacts with CHOWN, and needs
# SETUID/SETGID/SETPCAP solely to enter the restricted Restic identity. setpriv
# then clears the bounding/inheritable/ambient sets, supplementary groups and
# these effective capabilities before any network command.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN CAP_SETUID CAP_SETGID CAP_SETPCAP
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_CHOWN CAP_SETUID CAP_SETGID CAP_SETPCAP
SystemCallArchitectures=native
