# Medusa backend, installed to /etc/systemd/system/medusa.service by
# deploy/provision.sh.
#
# backend-current is a root-managed symlink to an immutable release. The
# runtime user can read the release and its environment, but ProtectSystem and
# ReadOnlyPaths prevent it from changing any part of /srv/peptides.

[Unit]
Description=Medusa backend (peptideeinkaufen.de)
Documentation=https://github.com/kastriottanaj/peptide/blob/main/docs/deploy.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

# Stop restarting after 5 failures in 5 minutes so a configuration or
# permission error remains visible instead of becoming an endless restart loop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=medusa
Group=medusa
WorkingDirectory=/srv/peptides/backend-current/apps/backend/.medusa/server

EnvironmentFile=/srv/peptides/.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/lib/peptides
Environment=XDG_CONFIG_HOME=/var/lib/peptides/.config
Environment=XDG_CACHE_HOME=/var/lib/peptides/.cache
UnsetEnvironment=BASH_ENV ENV CDPATH GLOBIGNORE LD_PRELOAD LD_LIBRARY_PATH
UnsetEnvironment=NODE_OPTIONS NPM_CONFIG_SCRIPT_SHELL npm_config_script_shell
UnsetEnvironment=GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM PYTHONHOME PYTHONPATH

# Invoke the CLI installed in the immutable release. Do not use npx, PATH
# lookup, or a repository checkout executable.
ExecStartPre=/usr/bin/test -d /srv/peptides/backend-current/apps/backend/.medusa/server
ExecStartPre=/usr/bin/test -f /srv/peptides/backend-current/node_modules/@medusajs/cli/cli.js
ExecStartPre=/usr/bin/test ! -e /srv/peptides/recovery-required
ExecStartPre=/usr/bin/test ! -L /srv/peptides/recovery-required
ExecStartPre=/usr/bin/test ! -e /srv/peptides/activation-required
ExecStartPre=/usr/bin/test ! -L /srv/peptides/activation-required
ExecStartPre=/usr/bin/mkdir -p /var/lib/peptides/static
ExecStartPre=/usr/bin/chmod 0700 /var/lib/peptides/static
ExecStart=/usr/bin/node /srv/peptides/backend-current/node_modules/@medusajs/cli/cli.js start --host 127.0.0.1 --port 9000

Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=90

StandardOutput=journal
StandardError=journal
SyslogIdentifier=medusa

# The only writable application path is /var/lib/peptides, created and owned by
# systemd. Releases, pointers, configuration, repository and storefront under
# /srv/peptides remain read-only to the service.
StateDirectory=peptides
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ReadOnlyPaths=/srv/peptides

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
